
/*
 * Creates a new file or modifies the content of an existing file. For NON-Hyperlambda files only -
 * Hyperlambda (.hl) must be produced by the generate-hyperlambda function, never written by hand.
 * 
 * Arguments:
 * 
 * - [filename] is the mandatory filename of the file that should be saved or created.
 * - [content] being mandatory text content for file.
 */
.arguments

   // Injected by the framework.
   _session:string

   // Mandatory filename.
   filename:string

   // Mandatory text content for file.
   content:string

// Ensuring user is root.
auth.ticket.verify:root

// Sanity checking invocation.
validators.mandatory:x:@.arguments/*/filename
validators.mandatory:x:@.arguments/*/content

// Prepending slash unless specified by caller.
if
   not
      strings.starts-with:x:@.arguments/*/filename
         .:/
   .lambda
      set-value:x:@.arguments/*/filename
         strings.concat
            .:/
            get-value:x:@.arguments/*/filename

// Making sure we do not overwrite system files.
if
   not
      or
         strings.starts-with:x:@.arguments/*/filename
            .:/etc/
         strings.starts-with:x:@.arguments/*/filename
            .:/modules/
   .lambda
      throw:"You can only save files to the '/modules/' and '/etc/' folders"
         status:int:400
         public:bool:true

// Checking if this is a temporary file, and if yes, making sure our temporary folder exists.
if
   and
      strings.starts-with:x:@.arguments/*/filename
         .:/etc/tmp/
      not
         io.folder.exists:/etc/tmp/
   .lambda
      io.folder.create:/etc/tmp/

// Hyperlambda is never hand-written - it can only be produced by the generate-hyperlambda function,
// which validates and saves it itself. Refusing any direct attempt to save a Hyperlambda file.
if
   strings.ends-with:x:@.arguments/*/filename
      .:.hl
   .lambda
      throw:"Hyperlambda files cannot be written directly. Use the generate-hyperlambda function - it produces correct Hyperlambda and saves it through its [filename] argument. Never hand-write Hyperlambda."
         public:bool:true
         status:int:400

// Saving file.
io.file.save:x:@.arguments/*/filename
   get-value:x:@.arguments/*/content

// Signaling frontend
sockets.signal:x:@.arguments/*/_session
   args
      type:floating_message
      floating_message:File successfully created
      floating_state:success

// Returning success
yield
   result:success
