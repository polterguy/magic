
/*
 * Creates a new file or fully overwrites an existing file. For minor edits to an existing file,
 * prefer the `patch-file` function. Hyperlambda files are verified before they are saved, so broken
 * Hyperlambda never reaches disk - prefer the `generate-hyperlambda` function for writing Hyperlambda
 * from a description, and use this function for targeted edits to code that already exists. Does
 * NOT create folders - the parent folder must already exist; create it first with the `create-folder`
 * function.
 */
.arguments

   // Injected by the framework.
   _session:string

   // Mandatory filename.
   filename:string

   // Mandatory text content for file.
   content:string

// Ensuring user is root.
auth.ticket.verify:root

// Sanity checking invocation.
validators.mandatory:x:@.arguments/*/filename
validators.mandatory:x:@.arguments/*/content

// Prepending slash unless specified by caller.
if
   not
      strings.starts-with:x:@.arguments/*/filename
         .:/
   .lambda
      set-value:x:@.arguments/*/filename
         strings.concat
            .:/
            get-value:x:@.arguments/*/filename

// Making sure we do not overwrite system files.
if
   not
      or
         strings.starts-with:x:@.arguments/*/filename
            .:/etc/
         strings.starts-with:x:@.arguments/*/filename
            .:/modules/
   .lambda
      throw:"You can only save files to the '/modules/' and '/etc/' folders"
         status:int:400
         public:bool:true

// Checking if this is a temporary file, and if yes, making sure our temporary folder exists.
if
   and
      strings.starts-with:x:@.arguments/*/filename
         .:/etc/tmp/
      not
         io.folder.exists:/etc/tmp/
   .lambda
      io.folder.create:/etc/tmp/

// Hyperlambda is verified before it is saved, so code that does not parse, or that references a slot
// which does not exist, is rejected instead of reaching disk. Notice, we compare lowercased to also
// catch ".HL" style filenames on case-insensitive file systems.
strings.to-lower:x:@.arguments/*/filename
if
   strings.ends-with:x:@strings.to-lower
      .:.hl
   .lambda
      execute-file:/misc/workflows/workflows/hyperlambda/verify-hyperlambda.hl
         hyperlambda:x:@.arguments/*/content
      if
         eq:x:@execute-file/*/valid
            .:bool:false
         .lambda
            strings.concat
               .:"Hyperlambda did not verify, and was not saved: "
               strings.join:x:@execute-file/*/errors/*
                  .:"; "
            throw:x:@strings.concat
               public:bool:true
               status:int:400

// Verifying the parent folder exists, since [io.file.save] cannot create it.
strings.split:x:@.arguments/*/filename
   .:/
remove-nodes:x:@strings.split/0/-
.parent
set-value:x:@.parent
   strings.concat
      .:/
      strings.join:x:@strings.split/*
         .:/
      .:/
if
   not
      io.folder.exists:x:@.parent
   .lambda
      strings.concat
         .:"Parent folder '"
         get-value:x:@.parent
         .:"' does not exist - create it with the create-folder function, then retry"
      throw:x:@strings.concat
         public:bool:true
         status:int:400

// Saving file.
io.file.save:x:@.arguments/*/filename
   get-value:x:@.arguments/*/content

// Signaling frontend
sockets.signal:x:@.arguments/*/_session
   args
      type:floating_message
      floating_message:File successfully created
      floating_state:success

// Returning success
yield
   result:success
