
/*
 * Creates a new folder with the [folder] path. Call this before the first file write into a new
 * path, since the file-writing functions never create folders. Idempotent - if the folder already
 * exists the function simply returns without error.
 */
.arguments

   // Injected by the framework.
   _session:string

   // Mandatory path to folder that should be created.
   folder:string

// Ensuring user is root.
auth.ticket.verify:root

// Sanity checking invocation.
validators.mandatory:x:@.arguments/*/folder

// Prepending slash unless specified by caller.
if
   not
      strings.starts-with:x:@.arguments/*/folder
         .:/
   .lambda
      set-value:x:@.arguments/*/folder
         strings.concat
            .:/
            get-value:x:@.arguments/*/folder

// Returning early if the folder already exists, making the function idempotent such that
// callers can safely create folders defensively before writing files into them.
if
   io.folder.exists:x:@.arguments/*/folder
   .lambda
      return
         result:already-existed

// Verifying folder starts with "/etc/" or "/modules/"
if
   not
      or
         strings.starts-with:x:@.arguments/*/folder
            .:/etc/
         strings.starts-with:x:@.arguments/*/folder
            .:/modules/
   .lambda
      throw:"You can only create new folders in the '/modules/' and '/etc/ folders'"
         public:bool:true
         status:int:400

// Creating folder.
io.folder.create:x:@.arguments/*/folder

// Signaling frontend
sockets.signal:x:@.arguments/*/_session
   args
      type:floating_message
      floating_message:Folder successfully created
      floating_state:success

// Returning success
return
   result:success
