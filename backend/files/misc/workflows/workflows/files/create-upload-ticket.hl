
/*
 * Creates a short-lived upload ticket allowing the caller to upload a file using streamed
 * multipart/form-data content, without passing the file through the MCP channel. Returns [url],
 * [ticket] and [expires_utc]. Upload the file by POST'ing to [url] with an Authorization header
 * being 'Bearer ' + [ticket], and multipart form fields [file] being the file content, [filename]
 * being the destination path on the server, and optionally [width] and/or [height] to resize
 * images - supplying only one of [width] or [height] preserves the aspect ratio of the image.
 * Optionally supply [convert] being boolean true to re-encode an image into the format implied
 * by the extension of [filename] without resizing it - resizing implies conversion either way.
 */
.arguments

// Ensuring user is root.
auth.ticket.verify:root

// Calculating expiration time.
math.add
   date.now
   time
      minutes:20

// Creating our upload token.
auth.ticket.create
   username:service
   expires:x:@math.add
   roles
      .:root

// Creating our URL.
.url
set-value:x:@.url
   strings.concat
      request.scheme
      .:"://"
      request.host
      .:/magic/system/file-system/upload

// Returning ticket to caller.
yield
   url:x:@.url
   ticket:x:@auth.ticket.create
   expires_utc:x:@math.add
