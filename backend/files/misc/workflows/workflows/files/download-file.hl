
/*
 * Downloads the specified file to the client. Returns [url] being a short-lived
 * URL that downloads the file with a plain HTTP GET request, allowing you to download binary files,
 * images, etc.
 */
.arguments

   // Injected by the framework.
   _session:string

   // Mandatory relative path of file to download
   filename:string

// Ensuring user is root.
auth.ticket.verify:root

// Sanity checking invocation.
validators.mandatory:x:@.arguments/*/filename

// Prepending slash unless specified by caller.
if
   not
      strings.starts-with:x:@.arguments/*/filename
         .:/
   .lambda
      set-value:x:@.arguments/*/filename
         strings.concat
            .:/
            get-value:x:@.arguments/*/filename

// Verifying that file exists.
if
   not
      io.file.exists:x:@.arguments/*/filename
   .lambda

      // Oops ...!!
      throw:File does not exist
         public:bool:true
         status:int:404

// Calculating expiration time.
math.add
   date.now
   time
      minutes:20

// We'll need a token for the download URL.
auth.ticket.create
   username:service
   expires:x:@math.add
   roles
      .:root

/*
 * Signaling frontend.
 * This will create a download link in the frontend dashboard.
 */
sockets.signal:x:@.arguments/*/_session
   roles:root
   args
      type:download_file
      filename:x:@.arguments/*/filename
      ticket:x:@auth.ticket.create

// Creating our URL.
.url
set-value:x:@.url
   strings.concat
      .:"https://"
      request.host
      .:"/magic/system/file-system/file-with-token?file="
      strings.url-encode:x:@.arguments/*/filename
      .:"&access_token="
      get-value:x:@auth.ticket.create

// Returning success
crypto.random
   min:10
   max:10
yield
   download_id:x:@crypto.random
   filename:x:@.arguments/*/filename
   url:x:@.url
   expires_utc:x:@math.add
