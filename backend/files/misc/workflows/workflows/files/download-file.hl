
/*
 * Downloads the specified file to the client by signalling the frontend, which renders a download
 * button carrying a short-lived ticket. Works for binary files, images, etc. No URL is returned -
 * the frontend already knows which backend it is attached to, and builds the link itself.
 */
.arguments

   // Injected by the framework.
   _session:string

   // Mandatory relative path of file to download
   filename:string

// Ensuring user is root.
auth.ticket.verify:root

// Sanity checking invocation.
validators.mandatory:x:@.arguments/*/filename

// Prepending slash unless specified by caller.
if
   not
      strings.starts-with:x:@.arguments/*/filename
         .:/
   .lambda
      set-value:x:@.arguments/*/filename
         strings.concat
            .:/
            get-value:x:@.arguments/*/filename

// Verifying that file exists.
if
   not
      io.file.exists:x:@.arguments/*/filename
   .lambda

      // Oops ...!!
      throw:File does not exist
         public:bool:true
         status:int:404

// Calculating expiration time.
math.add
   date.now
   time
      minutes:20

// We'll need a token for the download URL.
auth.ticket.create
   username:service
   expires:x:@math.add
   roles
      .:root

/*
 * Signaling frontend.
 * This will create a download link in the frontend dashboard.
 */
sockets.signal:x:@.arguments/*/_session
   roles:root
   args
      type:download_file
      filename:x:@.arguments/*/filename
      ticket:x:@auth.ticket.create

// Returning success
crypto.random
   min:10
   max:10
yield
   download_id:x:@crypto.random
   filename:x:@.arguments/*/filename
   expires_utc:x:@math.add
