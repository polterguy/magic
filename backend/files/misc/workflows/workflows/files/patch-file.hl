
/*
 * Applies a unified diff patch to an existing file - the way to edit a file when one edit spans
 * several separate places in it. To replace a single exact passage prefer the replace-in-file
 * function, which verifies its result before saving it.
 *
 * Only files inside the '/modules/' and '/etc/' folders can be patched, and the file has to exist
 * from before.
 *
 * Notice, a diff cannot be verified before it is applied, so unlike the create-file and
 * replace-in-file functions this one does not guarantee that the Hyperlambda it leaves behind
 * parses - verify the file afterwards with the verify-hyperlambda function when you patch a
 * Hyperlambda file.
 */
.arguments

   // Injected by the framework.
   _session:string

   // Mandatory filename.
   filename:string

   // Mandatory patch.
   patch:string

// Ensuring user is root.
auth.ticket.verify:root

// Sanity checking invocation.
validators.mandatory:x:@.arguments/*/filename
validators.mandatory:x:@.arguments/*/patch

// Prepending slash unless specified by caller.
if
   not
      strings.starts-with:x:@.arguments/*/filename
         .:/
   .lambda
      set-value:x:@.arguments/*/filename
         strings.concat
            .:/
            get-value:x:@.arguments/*/filename

// Making sure we do not patch system files.
if
   not
      or
         strings.starts-with:x:@.arguments/*/filename
            .:/etc/
         strings.starts-with:x:@.arguments/*/filename
            .:/modules/
   .lambda
      throw:"You can only patch files in the '/modules/' and '/etc/' folders"
         status:int:400
         public:bool:true

// Ensuring file exists.
if
   not
      io.file.exists:x:@.arguments/*/filename
   .lambda
      throw:File does not exist
         status:int:404
         public:bool:true

// Applying patch.
io.file.patch:x:@.arguments/*/filename
   get-value:x:@.arguments/*/patch

// Signaling frontend
sockets.signal:x:@.arguments/*/_session
   args
      type:floating_message
      floating_message:File was successfully patched
      floating_state:success

// Returning success
yield
   result:success
