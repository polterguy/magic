
/*
 * Applies a unified diff patch to an existing file. For NON-Hyperlambda files only - Hyperlambda (.hl)
 * is never hand-edited; re-create it with the generate-hyperlambda function instead.
 *
 * IMPORTANT - This file CANNOT be used to save Hyperlambda, only other types of files.
 */
.arguments

   // Injected by the framework.
   _session:string

   // Mandatory filename.
   filename:string

   // Mandatory patch.
   patch:string

// Ensuring user is root.
auth.ticket.verify:root

// Sanity checking invocation.
validators.mandatory:x:@.arguments/*/filename
validators.mandatory:x:@.arguments/*/patch

// Prepending slash unless specified by caller.
if
   not
      strings.starts-with:x:@.arguments/*/filename
         .:/
   .lambda
      set-value:x:@.arguments/*/filename
         strings.concat
            .:/
            get-value:x:@.arguments/*/filename

// Making sure we do not patch system files.
if
   not
      or
         strings.starts-with:x:@.arguments/*/filename
            .:/etc/
         strings.starts-with:x:@.arguments/*/filename
            .:/modules/
   .lambda
      throw:"You can only patch files in the '/modules/' and '/etc/' folders"
         status:int:400
         public:bool:true

// Hyperlambda is never hand-edited - regenerate the whole file with the generate-hyperlambda function
// instead. Refusing any attempt to patch a Hyperlambda file.
if
   strings.ends-with:x:@.arguments/*/filename
      .:.hl
   .lambda
      throw:"Hyperlambda files cannot be patched directly. Re-create the file with the generate-hyperlambda function instead of hand-editing Hyperlambda."
         public:bool:true
         status:int:400

// Ensuring file exists.
if
   not
      io.file.exists:x:@.arguments/*/filename
   .lambda
      throw:File does not exist
         status:int:404
         public:bool:true

// Applying patch.
io.file.patch:x:@.arguments/*/filename
   get-value:x:@.arguments/*/patch

// Signaling frontend
sockets.signal:x:@.arguments/*/_session
   args
      type:floating_message
      floating_message:File was successfully patched
      floating_state:success

// Returning success
yield
   result:success
