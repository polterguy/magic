/*
 * Clears the first element matching a CSS selector and types text into it, in an existing
 * headless browser (Puppeteer) session.
 *
 * Use this to populate input fields and textareas with a new value, replacing whatever they
 * already contain; use puppeteer-type instead to type without clearing. The text comes from
 * [text], or from a configuration setting when [config-key] is supplied - the latter keeps
 * secrets such as passwords out of the invocation.
 */
.arguments

   // Mandatory session id as returned from puppeteer-connect.
   session_id:string

   // Mandatory CSS selector to fill.
   selector:string

   // Text to type after clearing. Optional if [config-key] is provided.
   text:string

   // Configuration key resolving the text value. Optional if [text] is provided.
   config-key:string

   // Optional delay between key presses in milliseconds.
   delay:int

// Ensuring user is root.
auth.ticket.verify:root

// Sanity checking invocation.
validators.mandatory:x:@.arguments/*/session_id
validators.mandatory:x:@.arguments/*/selector
if
   and
      exists:x:@.arguments/*/text
      not-null:x:@.arguments/*/text
      exists:x:@.arguments/*/config-key
      not-null:x:@.arguments/*/config-key
   .lambda
      throw:Only one of [text] or [config-key] can be supplied
         status:int:400
         public:bool:true
if
   and
      or
         not-exists:x:@.arguments/*/text
         null:x:@.arguments/*/text
      or
         not-exists:x:@.arguments/*/config-key
         null:x:@.arguments/*/config-key
   .lambda
      throw:One of [text] or [config-key] must be supplied
         status:int:400
         public:bool:true

// Optional arguments.
add:x:./*/puppeteer.fill
   get-nodes:x:@.arguments/*/text
   get-nodes:x:@.arguments/*/delay
   get-nodes:x:@.arguments/*/config-key

// Core invocation.
puppeteer.fill:x:@.arguments/*/session_id
   selector:x:@.arguments/*/selector

return
   result:success
