/*
 * Returns the current page's title from an existing headless browser (Puppeteer) session.
 *
 * A cheap way to verify a navigation ended up on the expected page without downloading its
 * entire HTML.
 */
.arguments

   // Mandatory session id as returned from puppeteer-connect.
   session_id:string

// Ensuring user is root.
auth.ticket.verify:root

// Sanity checking invocation.
validators.mandatory:x:@.arguments/*/session_id

// Core invocation.
puppeteer.title:x:@.arguments/*/session_id

yield
   title:x:@puppeteer.title
