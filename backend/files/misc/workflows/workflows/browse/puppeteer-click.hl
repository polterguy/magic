/*
 * Clicks the first element matching a CSS selector in an existing headless browser (Puppeteer)
 * session.
 *
 * Use this to press buttons, follow links, or trigger any element's click handler. If the click
 * starts a navigation, follow up with puppeteer-wait-for-url or puppeteer-wait-for-selector
 * before reading the page.
 */
.arguments

   // Mandatory session id as returned from puppeteer-connect.
   session_id:string

   // Mandatory CSS selector to click.
   selector:string

   // Optional mouse button. Legal values are 'left', 'middle', and 'right'.
   button:string

   // Optional number of clicks.
   click_count:int

   // Optional delay between mouse down and mouse up in milliseconds.
   delay:int

// Ensuring user is root.
auth.ticket.verify:root

// Sanity checking invocation.
validators.mandatory:x:@.arguments/*/session_id
validators.mandatory:x:@.arguments/*/selector

// Optional arguments.
add:x:./*/puppeteer.click
   get-nodes:x:@.arguments/*/button
   get-nodes:x:@.arguments/*/click_count
   get-nodes:x:@.arguments/*/delay

// Core invocation.
puppeteer.click:x:@.arguments/*/session_id
   selector:x:@.arguments/*/selector

return
   result:success
