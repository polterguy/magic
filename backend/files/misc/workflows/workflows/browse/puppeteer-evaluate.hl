/*
 * Evaluates a JavaScript expression in the page of an existing headless browser (Puppeteer)
 * session and returns its result.
 *
 * This is the escape hatch when no dedicated function fits: extract data from the DOM, scroll,
 * or manipulate the page directly. The result must be JSON-serializable to travel back to the
 * caller.
 */
.arguments

   // Mandatory session id as returned from puppeteer-connect.
   session_id:string

   // Mandatory JavaScript to evaluate in the page. Without [args] it is evaluated as a bare expression whose value is returned. With [args] it must be a function expression, e.g. '(a,b)=>{...}', invoked with [args] as its positional arguments.
   expression:string

   // Optional arguments for JS function invocation.
   args:*

// Ensuring user is root.
auth.ticket.verify:root

// Sanity checking invocation.
validators.mandatory:x:@.arguments/*/session_id
validators.mandatory:x:@.arguments/*/expression

// Optional arguments.
add:x:./*/puppeteer.evaluate
   get-nodes:x:@.arguments/*/args

// Core invocation.
puppeteer.evaluate:x:@.arguments/*/session_id
   expression:x:@.arguments/*/expression

yield
   result:x:@puppeteer.evaluate
