/*
 * Creates a new headless browser (Puppeteer) session and returns its session id.
 *
 * This is the entry point for all browsing functions: call this first, then pass the returned
 * session id as [session_id] to every other puppeteer function, and finish by calling
 * puppeteer-close to release the browser. Sessions also expire automatically according to
 * [timeout_minutes] and [max_lifetime_minutes].
 */
.arguments

   // Optional boolean. Defaults to true.
   headless:bool

   // Optional full path to Chromium/Chrome.
   executable:string

   // Optional browser launch timeout in milliseconds. Defaults to 30000 (30 seconds).
   timeout:int

   // Optional Chromium user data directory.
   user-data-dir:string

   // Optional list of Chromium args.
   args:*

   // Optional sliding expiration in minutes.
   timeout_minutes:int

   // Optional max session lifetime in minutes.
   max_lifetime_minutes:int

// Ensuring user is root.
auth.ticket.verify:root

// Optional arguments.
add:x:./*/puppeteer.connect
   get-nodes:x:@.arguments/*/headless
   get-nodes:x:@.arguments/*/executable
   get-nodes:x:@.arguments/*/timeout
   get-nodes:x:@.arguments/*/user-data-dir
   get-nodes:x:@.arguments/*/args
   get-nodes:x:@.arguments/*/timeout_minutes
   get-nodes:x:@.arguments/*/max_lifetime_minutes

// Core invocation.
puppeteer.connect

yield
   session_id:x:@puppeteer.connect
