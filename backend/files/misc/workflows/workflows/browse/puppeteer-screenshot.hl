/*
 * Takes a screenshot of the current page in an existing headless browser (Puppeteer) session
 * and saves it to the specified [filename] on the server.
 *
 * Use this to visually verify what the page looks like, or to produce images of rendered pages.
 */
.arguments

   // Mandatory session id as returned from puppeteer-connect.
   session_id:string

   // Mandatory output file path.
   filename:string

   // Optional boolean to capture full page.
   full-page:bool

   // Optional screenshot type.
   type:string

   // Optional JPEG quality 0-100.
   quality:int

// Ensuring user is root.
auth.ticket.verify:root

// Sanity checking invocation.
validators.mandatory:x:@.arguments/*/session_id
validators.mandatory:x:@.arguments/*/filename

// Optional arguments.
add:x:./*/puppeteer.screenshot
   get-nodes:x:@.arguments/*/full-page
   get-nodes:x:@.arguments/*/type
   get-nodes:x:@.arguments/*/quality

// Core invocation.
puppeteer.screenshot:x:@.arguments/*/session_id
   filename:x:@.arguments/*/filename

return
   result:success
