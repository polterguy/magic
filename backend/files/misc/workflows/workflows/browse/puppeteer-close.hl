/*
 * Closes an existing headless browser (Puppeteer) session and releases its resources.
 *
 * Always call this when you are done browsing. The session id becomes invalid afterwards.
 */
.arguments

   // Mandatory session id as returned from puppeteer-connect.
   session_id:string

// Ensuring user is root.
auth.ticket.verify:root

// Sanity checking invocation.
validators.mandatory:x:@.arguments/*/session_id

// Core invocation.
puppeteer.close:x:@.arguments/*/session_id

return
   result:success
