/*
 * Navigates an existing headless browser (Puppeteer) session to the specified URL.
 *
 * Waits until the navigation is considered finished according to [wait_until] before returning,
 * making the page ready for subsequent functions such as puppeteer-content or puppeteer-click.
 */
.arguments

   // Mandatory session id as returned from puppeteer-connect.
   session_id:string

   // Mandatory URL to navigate to.
   url:string

   // Optional navigation timeout in milliseconds.
   timeout:int

   // Optional. Legal values are 'load', 'domcontentloaded', 'networkidle0', and 'networkidle2'.
   wait_until:string

// Ensuring user is root.
auth.ticket.verify:root

// Sanity checking invocation.
validators.mandatory:x:@.arguments/*/session_id
validators.mandatory:x:@.arguments/*/url

// Optional arguments.
add:x:./*/puppeteer.goto
   get-nodes:x:@.arguments/*/timeout
   get-nodes:x:@.arguments/*/wait_until

// Core invocation.
puppeteer.goto:x:@.arguments/*/session_id
   url:x:@.arguments/*/url

return
   result:success
