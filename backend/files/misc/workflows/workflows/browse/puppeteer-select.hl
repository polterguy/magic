/*
 * Selects one or more option values in a dropdown (HTML select element) in an existing headless
 * browser (Puppeteer) session.
 *
 * The [values] are matched against the option elements' value attributes, and multiple values
 * only apply to select elements allowing multiple selections.
 */
.arguments

   // Mandatory session id as returned from puppeteer-connect.
   session_id:string

   // Mandatory CSS selector for a select element.
   selector:string

   // Mandatory option values to select.
   values:*

// Ensuring user is root.
auth.ticket.verify:root

// Sanity checking invocation.
validators.mandatory:x:@.arguments/*/session_id
validators.mandatory:x:@.arguments/*/selector
validators.mandatory:x:@.arguments/*/values

// Optional arguments.
add:x:./*/puppeteer.select
   get-nodes:x:@.arguments/*/values

// Core invocation.
puppeteer.select:x:@.arguments/*/session_id
   selector:x:@.arguments/*/selector

return
   result:success
