/*
 * Waits until an element matching a CSS selector appears in the DOM of an existing headless
 * browser (Puppeteer) session, or the timeout expires.
 *
 * Use this after navigating or clicking on pages that render content with JavaScript, to make
 * sure the element you want to read or interact with actually exists before proceeding.
 */
.arguments

   // Mandatory session id as returned from puppeteer-connect.
   session_id:string

   // Mandatory CSS selector to wait for.
   selector:string

   // Optional timeout in milliseconds to wait for the selector to appear. Defaults to 30000 (30 seconds).
   timeout:int

   // Optional boolean requiring selector to be visible.
   visible:bool

   // Optional boolean requiring selector to be hidden.
   hidden:bool

// Ensuring user is root.
auth.ticket.verify:root

// Sanity checking invocation.
validators.mandatory:x:@.arguments/*/session_id
validators.mandatory:x:@.arguments/*/selector

// Optional arguments.
add:x:./*/puppeteer.wait-for-selector
   get-nodes:x:@.arguments/*/timeout
   get-nodes:x:@.arguments/*/visible
   get-nodes:x:@.arguments/*/hidden

// Core invocation.
puppeteer.wait-for-selector:x:@.arguments/*/session_id
   selector:x:@.arguments/*/selector

return
   result:success
