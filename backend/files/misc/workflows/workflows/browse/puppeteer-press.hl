/*
 * Presses a single keyboard key on the first element matching a CSS selector in an existing
 * headless browser (Puppeteer) session.
 *
 * Use this for key-driven interactions typing cannot express, such as pressing 'Enter' to submit
 * a form or 'Escape' to dismiss a dialog.
 */
.arguments

   // Mandatory session id as returned from puppeteer-connect.
   session_id:string

   // Mandatory CSS selector to press key on.
   selector:string

   // Mandatory key name to press.
   key:string

   // Optional delay in milliseconds.
   delay:int

// Ensuring user is root.
auth.ticket.verify:root

// Sanity checking invocation.
validators.mandatory:x:@.arguments/*/session_id
validators.mandatory:x:@.arguments/*/selector
validators.mandatory:x:@.arguments/*/key

// Optional arguments.
add:x:./*/puppeteer.press
   get-nodes:x:@.arguments/*/delay

// Core invocation.
puppeteer.press:x:@.arguments/*/session_id
   selector:x:@.arguments/*/selector
   key:x:@.arguments/*/key

return
   result:success
