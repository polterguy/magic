/*
 * Waits until the page URL of an existing headless browser (Puppeteer) session matches the
 * specified value, or the timeout expires.
 *
 * Use this after clicks or form submissions that trigger navigation, to make sure the new page
 * has been reached before reading it.
 */
.arguments

   // Mandatory session id as returned from puppeteer-connect.
   session_id:string

   // Mandatory URL to wait for.
   url:string

   // Optional timeout in milliseconds.
   timeout:int

// Ensuring user is root.
auth.ticket.verify:root

// Sanity checking invocation.
validators.mandatory:x:@.arguments/*/session_id
validators.mandatory:x:@.arguments/*/url

// Optional arguments.
add:x:./*/puppeteer.wait-for-url
   get-nodes:x:@.arguments/*/timeout

// Core invocation.
puppeteer.wait-for-url:x:@.arguments/*/session_id
   url:x:@.arguments/*/url

return
   result:success
