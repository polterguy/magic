/*
 * Returns the current page's full HTML from an existing headless browser (Puppeteer) session.
 *
 * Use this after navigating with puppeteer-goto to scrape or inspect the page as it is currently
 * rendered, including markup produced dynamically by JavaScript.
 */
.arguments

   // Mandatory session id as returned from puppeteer-connect.
   session_id:string

// Ensuring user is root.
auth.ticket.verify:root

// Sanity checking invocation.
validators.mandatory:x:@.arguments/*/session_id

// Core invocation.
puppeteer.content:x:@.arguments/*/session_id

yield
   content:x:@puppeteer.content
