/*
 * Returns the current page URL from an existing headless browser (Puppeteer) session.
 *
 * Useful for verifying where a click or navigation actually ended up, for instance after
 * redirects or form submissions.
 */
.arguments

   // Mandatory session id as returned from puppeteer-connect.
   session_id:string

// Ensuring user is root.
auth.ticket.verify:root

// Sanity checking invocation.
validators.mandatory:x:@.arguments/*/session_id

// Core invocation.
puppeteer.url:x:@.arguments/*/session_id

yield
   url:x:@puppeteer.url
