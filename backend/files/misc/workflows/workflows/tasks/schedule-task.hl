
/*
 * Schedules the specified [id] task such that it's being automatically executed in the future.
 *
 * You can schedule the task to execute once in the future, or according to a repetition value.
 */
.arguments

   // Injected by the framework.
   _session:string

   // Id of task to schedule.
   id:string

   // Optional argument being an exact date in the future for when task should execute.
   due:date

   // Optional repetition pattern. Three formats exist; 'n.unit' where unit is seconds, minutes, hours, days, weeks or months, e.g. '5.minutes' - 'weekdays.HH.mm.ss' where weekdays is one or more '|'-separated weekday names or '**' for all, e.g. 'saturday|sunday.22.00.00' - or 'MM.dd.HH.mm.ss' where MM and dd are '|'-separated numbers or '**', e.g. '**.1.05.00.00' implying the 1st of every month at 05.00 UTC.
   repeats:string

// Ensuring user is root.
auth.ticket.verify:root

// Parametrizing invocation.
add:x:./*/tasks.schedule
   get-nodes:x:@.arguments/*/due
   get-nodes:x:@.arguments/*/repeats

// Scheduling our task.
tasks.schedule:x:@.arguments/*/id

// Signaling frontend
sockets.signal:x:@.arguments/*/_session
   args
      type:floating_message
      floating_message:Task successfully scheduled
      floating_state:success

// Returning success to caller.
return
   result:success
