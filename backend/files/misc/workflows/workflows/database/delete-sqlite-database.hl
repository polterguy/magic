
/*
 * Deletes the specified [database] SQLite database.
 */
.arguments

   // Injected by the framework.
   _session:string

   // Mandatory name of database to delete.
   database:string

// Ensuring user is root.
auth.ticket.verify:root

// Sanity checking invocation.
validators.mandatory:x:@.arguments/*/database
validators.regex:x:@.arguments/*/database
   regex:^[a-z0-9_-]+$

// Making sure user doesn't delete magic database.
if
   eq:x:@.arguments/*/database
      .:magic
   .lambda
      throw:"You can't delete the magic database, it is a protected system database and your system will stop working if you delete it."
         status:int:400
         public:bool:true

// Verifying database exists.
strings.concat
   .:/data/
   get-value:x:@.arguments/*/database
   .:.db
if
   not
      io.file.exists:x:@strings.concat
   .lambda
      throw:Database does not exists
         public:bool:true
         status:400

// Creating our database file.
io.file.delete:x:@strings.concat

// Flushing database cache.
sqlite.connections.flush

// Flushing database cache.
cache.set:magic.sql.databases.sqlite.generic

// Signaling frontend
sockets.signal:x:@.arguments/*/_session
   args
      type:floating_message
      floating_message:SQLite database successfully deleted
      floating_state:success

// Returning success to caller.
return
   result:success
