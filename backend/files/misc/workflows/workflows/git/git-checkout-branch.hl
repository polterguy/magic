
/*
 * Checks out a branch within the local Git repository at [path]. Set [create] to true to create the branch if it does not already exist.
 */
.arguments

   // Injected by the framework.
   _session:string

   // Mandatory folder to where Git repo is locally on disk.
   path:string

   // Mandatory branch to checkout.
   branch:string

   // Optional boolean indicating whether to create the branch.
   create:bool

// Ensuring user is root.
auth.ticket.verify:root

// Sanity checking invocation.
validators.mandatory:x:@.arguments/*/path
validators.mandatory:x:@.arguments/*/branch

// Sanity checking invocation.
if
   and
      not
         strings.starts-with:x:@.arguments/*/path
            .:/modules/
      not
         strings.starts-with:x:@.arguments/*/path
            .:/etc/
   .lambda
      throw:"Git repos must be in folders inside of either '/etc/' or '/modules/'"

// Parametrising slot
add:x:./*/git.checkout
   get-nodes:x:@.arguments/*/branch
   get-nodes:x:@.arguments/*/create

// Invoking slot.
git.checkout:x:@.arguments/*/path

// Signaling frontend
sockets.signal:x:@.arguments/*/_session
   args
      type:floating_message
      floating_message:Git branch successfully checked out
      floating_state:success

// Returning success
yield
   result:success
