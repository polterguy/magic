
/*
 * Pulls an existing Git repository.
 */
.arguments

   // Injected by the framework.
   _session:string

   // Mandatory folder to where Git repo is locally on disk.
   path:string

   // Optional argument being a named remote. Defaults to 'origin'.
   remote:string

   // Optional branch to pull. Defaults to 'main'.
   branch:string

// Ensuring user is root.
auth.ticket.verify:root

// Sanity checking invocation.
validators.mandatory:x:@.arguments/*/path
validators.default:x:@.arguments
   remote:origin
   branch:main

// Sanity checking invocation.
if
   and
      not
         strings.starts-with:x:@.arguments/*/path
            .:/modules/
      not
         strings.starts-with:x:@.arguments/*/path
            .:/etc/
   .lambda
      throw:"Git repos must be in folders inside of either '/etc/' or '/modules/'"

// Parametrising slot
add:x:./*/git.pull
   get-nodes:x:@.arguments/*/remote
   get-nodes:x:@.arguments/*/branch

// Invoking slot.
git.pull:x:@.arguments/*/path

// Signaling frontend
sockets.signal:x:@.arguments/*/_session
   args
      type:floating_message
      floating_message:Git pull executed successfully
      floating_state:success

// Returning success
yield
   result:success
