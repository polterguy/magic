
/*
 * The preferred way to create or change Hyperlambda - reach for this before writing any by hand.
 * Generates correct Hyperlambda code according to the specified [prompt], and saves it directly
 * when [filename] is supplied.
 *
 * To change an existing file rather than create one, pass its current contents as [old_code] and
 * describe only the change in [prompt]. Without [old_code] the call regenerates the file from the
 * prompt alone, discarding everything the prompt did not mention.
 *
 * Describe WHAT you want in plain language — the operation, table/columns, database, and any
 * access restriction. Do NOT write Hyperlambda yourself or describe node structure or indentation;
 * the generator produces correct syntax. One focused task per call; overly complex multi-step
 * instructions degrade output.
 */
.arguments

   // Injected by the framework.
   _session:string

   /*
    * Mandatory. The docstring of the file the generator will write. The generator sees nothing but
    * this text - not your database, not your files, not this conversation - so write it as the
    * precise comment a maintainer would put at the top of the finished file: what the code does,
    * stated as an action. Name the database and its type, every table and column, every argument
    * with its exact type and default, the exact output shape with field names, the role required
    * if any, and every literal - paths, URLs, email subjects, thresholds, sort orders. A fact that
    * is not in this text does not exist; "some data from a database" produces garbage. Know the
    * schema before prompting against a database. Describe the action, never the Hyperlambda.
    * When [old_code] is supplied, describe only the change to apply to it - "add paging", not the
    * whole endpoint.
    *
    * This argument must be enough by itself to 100% perfectly being able to reproduce the exact code.
    */
   prompt:string

   /*
    * Optional filename of where to save the Hyperlambda. The parent folder must already exist - create it first with the 
    * create-folder function.
    */
   filename:string

   // Optional value. If true, executes code immediately and returns result instead of code.
   immediate_mode:bool

   /*
    * Optional existing code you want changed. Supply it when modifying a file rather than creating
    * one, and describe only the change in [prompt] - the generator then keeps the comment the file
    * already had instead of replacing it with a description of the change.
    */
   old_code:string

// Ensuring user is root.
auth.ticket.verify:root

// Sanity checking invocation.
validators.mandatory:x:@.arguments/*/prompt

// Sanity checking filename, and removing it if it's empty.
if
   eq:x:@.arguments/*/filename
      .:
   .lambda
      remove-nodex:x:@.arguments/*/filename

try
   add:x:./*/http.post/*/payload
      get-nodes:x:@.arguments/*/prompt

   /*
    * The generator takes existing code as [data], which it forwards as [old_code] - the argument
    * that tells it this is a change rather than a fresh generation.
    */
   if
      and
         exists:x:@.arguments/*/old_code
         not-null:x:@.arguments/*/old_code
      .lambda
         unwrap:x:+/*/*
         add:x:../*/try/*/http.post/*/payload
            .
               data:x:@.arguments/*/old_code
   .start
   set-value:x:-
      date.now
   http.post:"https://ainiro.io/magic/modules/hyperlambda-generator/chat"
      convert:true
      timeout:60
      payload
   .total
   set-value:x:-
      math.subtract
         date.now
         get-value:x:@.start
   if
      and
         exists:x:@.arguments/*/filename
         not-null:x:@.arguments/*/filename
      .lambda

         // Prepending slash unless specified by caller.
         if
            not
               strings.starts-with:x:@.arguments/*/filename
                  .:/
            .lambda
               set-value:x:@.arguments/*/filename
                  strings.concat
                     .:/
                     get-value:x:@.arguments/*/filename

         // Making sure we do not overwrite system files.
         if
            not
               or
                  strings.starts-with:x:@.arguments/*/filename
                     .:/etc/
                  strings.starts-with:x:@.arguments/*/filename
                     .:/modules/
            .lambda
               throw:"You can only save files to the '/modules/' and '/etc/' folders"
                  status:int:400
                  public:bool:true

         // Verifying the parent folder exists, since [io.file.save] cannot create it.
         strings.split:x:@.arguments/*/filename
            .:/
         remove-nodes:x:@strings.split/0/-
         .parent
         set-value:x:@.parent
            strings.concat
               .:/
               strings.join:x:@strings.split/*
                  .:/
               .:/
         if
            not
               io.folder.exists:x:@.parent
            .lambda
               strings.concat
                  .:"Parent folder '"
                  get-value:x:@.parent
                  .:"' does not exist - create it with the create-folder function, then retry"
               throw:x:@strings.concat
                  public:bool:true
                  status:int:400

         // Caller wants to save the file, so we sanity check it first.
         hyper2lambda:x:@http.post/*/content/*/result
            comments:true
         lambda2hyper:x:-/*
            comments:true
         io.file.save:x:@.arguments/*/filename
            get-value:x:@lambda2hyper
         unwrap:x:+/*/*
         add:x:@try/*/yield
            .
               saved:bool:true
               filename:x:@.arguments/*/filename

         // Returning the arguments the generated file accepts, since the caller does not get the code.
         add:x:@try/*/yield
            .
               signature
         add:x:@try/*/yield/*/signature
            get-nodes:x:@hyper2lambda/*/.arguments/*

   // Signaling frontend
   sockets.signal:x:@.arguments/*/_session
      args
         type:floating_message
         floating_message:Hyperlambda successfully generated
         floating_state:success
   if
      and
         exists:x:@.arguments/*/immediate_mode
         eq:x:@.arguments/*/immediate_mode
            .:bool:true
      .lambda

         // Executing code and returning result instead of code.
         hyper2lambda:x:@http.post/*/content/*/result
         invoke:x:-
         if
            not-null:x:@invoke
            .lambda
               return-value:x:@invoke
         else-if
            exists:x:@invoke/*
            .lambda
               return-nodes:x:@invoke/*
         return
            message:Code did not return anything!

   if
      not-null:x:@.arguments/*/filename
      .lambda
         remove-nodes:x:@try/*/yield/*/code
         add:x:@try/*/yield
            .
               system_instruction:"This code verified before it was saved, so do not report defects in it from reading it - test it by invoking it, and use the `read-log` function if it fails."
   yield
      code:x:@http.post/*/content/*/result
      time_spent:x:@.total

.catch
   lambda2hyper:x:../*
   log.error:x:@.arguments/*/message
      stack:x:@lambda2hyper
   throw:x:@.arguments/*/message
      status:int:502
      public:bool:true
