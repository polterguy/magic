
/*
 * The ONLY supported way to create or change Hyperlambda - never author Hyperlambda by hand.
 * Generates correct Hyperlambda code according to the specified [prompt], and saves it directly
 * when [filename] is supplied.
 *
 * Describe WHAT you want in plain language — the operation, table/columns, database, and any
 * access restriction. Do NOT write Hyperlambda yourself or describe node structure or indentation;
 * the generator produces correct syntax. One focused task per call; overly complex multi-step
 * instructions degrade output.
 */
.arguments

   // Injected by the framework.
   _session:string

   // Mandatory argument describing the Hyperlambda code you want to generate.
   prompt:string

   // Optional filename of where to save the Hyperlambda. The parent folder must already exist - create it first with the create-folder function.
   filename:string

   // Optional value. If true, executes code immediately and returns result instead of code.
   immediate_mode:bool

// Ensuring user is root.
auth.ticket.verify:root

// Sanity checking invocation.
validators.mandatory:x:@.arguments/*/prompt

try
   add:x:./*/http.post/*/payload
      get-nodes:x:@.arguments/*/prompt
   .start
   set-value:x:-
      date.now
   http.post:"https://ainiro.io/magic/modules/hyperlambda-generator/chat"
      convert:true
      timeout:60
      payload
   .total
   set-value:x:-
      math.subtract
         date.now
         get-value:x:@.start
   if
      and
         exists:x:@.arguments/*/filename
         not-null:x:@.arguments/*/filename
      .lambda

         // Prepending slash unless specified by caller.
         if
            not
               strings.starts-with:x:@.arguments/*/filename
                  .:/
            .lambda
               set-value:x:@.arguments/*/filename
                  strings.concat
                     .:/
                     get-value:x:@.arguments/*/filename

         // Making sure we do not overwrite system files.
         if
            not
               or
                  strings.starts-with:x:@.arguments/*/filename
                     .:/etc/
                  strings.starts-with:x:@.arguments/*/filename
                     .:/modules/
            .lambda
               throw:"You can only save files to the '/modules/' and '/etc/' folders"
                  status:int:400
                  public:bool:true

         // Verifying the parent folder exists, since [io.file.save] cannot create it.
         strings.split:x:@.arguments/*/filename
            .:/
         remove-nodes:x:@strings.split/0/-
         .parent
         set-value:x:@.parent
            strings.concat
               .:/
               strings.join:x:@strings.split/*
                  .:/
               .:/
         if
            not
               io.folder.exists:x:@.parent
            .lambda
               strings.concat
                  .:"Parent folder '"
                  get-value:x:@.parent
                  .:"' does not exist - create it with the create-folder function, then retry"
               throw:x:@strings.concat
                  public:bool:true
                  status:int:400

         // Caller wants to save the file, so we sanity check it first.
         hyper2lambda:x:@http.post/*/content/*/result
            comments:true
         lambda2hyper:x:-/*
            comments:true
         io.file.save:x:@.arguments/*/filename
            get-value:x:@lambda2hyper
         unwrap:x:+/*/*
         add:x:@try/*/yield
            .
               saved:bool:true
               filename:x:@.arguments/*/filename

         // If the generated code declares arguments, returning the file's signature to caller.
         if
            exists:x:@hyper2lambda/*/.arguments
            .lambda
               unwrap:x:+/*
               execute-file:/misc/workflows/workflows/files/get-file-info.hl
                  filename:x:@.arguments/*/filename
               add:x:+/*/*
                  get-nodes:x:@execute-file/*
               add:x:@try/*/yield
                  .
                     signature

   // Signaling frontend
   sockets.signal:x:@.arguments/*/_session
      args
         type:floating_message
         floating_message:Hyperlambda successfully generated
         floating_state:success
   if
      and
         exists:x:@.arguments/*/immediate_mode
         eq:x:@.arguments/*/immediate_mode
            .:bool:true
      .lambda

         // Executing code and returning result instead of code.
         hyper2lambda:x:@http.post/*/content/*/result
         invoke:x:-
         if
            not-null:x:@invoke
            .lambda
               return-value:x:@invoke
         else-if
            exists:x:@invoke/*
            .lambda
               return-nodes:x:@invoke/*
         return
            message:Code did not return anything!

   if
      not-null:x:@.arguments/*/filename
      .lambda
         remove-nodes:x:@try/*/yield/*/code
         add:x:@try/*/yield
            .
               system_instruction:DO NOT try to debug this function. You have been empirically proven to be an IMBECILE on understanding Hyperlambda, since it resembkes NOTHING you have ever seen before! If you want to debug Hyperlambda endpoints you use HTTP invoke! Or you retrieve the OpenAPI specification!
   yield
      code:x:@http.post/*/content/*/result
      time_spent:x:@.total

.catch
   lambda2hyper:x:../*
   log.error:x:@.arguments/*/message
      stack:x:@lambda2hyper
   throw:x:@.arguments/*/message
      status:int:502
      public:bool:true
