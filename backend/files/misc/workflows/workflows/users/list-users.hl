
/*
 * List users in system
 * 
 * Optionally apply [limit] and [offset] to page.
 */
.arguments

   // Optional, defaults to 25 unless explicitly specified.
   limit:long

   // Optional, defaults to 0 unless explicitly specified.
   offset:long

// Ensuring user is root.
auth.ticket.verify:root

// Applying defaults.
validators.default:x:@.arguments
   limit:long:25
   offset:long:0

// Opening database connection.
data.connect:magic

   // Parametrizing invocation.
   add:x:./*/data.read
      get-nodes:x:@.arguments/*/limit
      get-nodes:x:@.arguments/*/offset

   // Selecting user.
   data.read
      table:users
      columns
         username
         created

   // Returning result to caller.
   yield
      users:x:@data.read/*
