
/*
 * Removes the specified [role] from the specified [username] user.
 */
.arguments

   // Injected by the framework.
   _session:string

   // Mandatory username of user to remove from role.
   username:string

   // Mandatory name of role.
   role:string

// Ensuring user is root.
auth.ticket.verify:root

// Sanity checking invocation.
validators.mandatory:x:@.arguments/*/username
validators.mandatory:x:@.arguments/*/role

// Opening database connection.
data.connect:magic

   // Deleting our role association.
   data.delete
      table:users_roles
      where
         and
            user.eq:x:@.arguments/*/username
            role.eq:x:@.arguments/*/role

   // Checking if we deleted something
   if
      eq:x:@data.delete
         .:int:0
      .lambda

         // Oops ...!!
         throw:Role not found on user
            public:bool:true
            status:int:404

// Signaling frontend
sockets.signal:x:@.arguments/*/_session
   args
      type:floating_message
      floating_message:User successfully removed from role
      floating_state:success

// Returning success
return
   result:success
