
/*
 * Adds the specified [username] user to the specified [role].
 */
.arguments

   // Injected by the framework.
   _session:string

   // Mandatory username of user to add to role.
   username:string

   // Mandatory name of role.
   role:string

// Ensuring user is root.
auth.ticket.verify:root

// Sanity checking invocation.
validators.mandatory:x:@.arguments/*/username
validators.mandatory:x:@.arguments/*/role

// Opening database connection.
data.connect:magic

   // Inserting our role.
   data.create
      table:users_roles
      values
         user:x:@.arguments/*/username
         role:x:@.arguments/*/role

// Signaling frontend
sockets.signal:x:@.arguments/*/_session
   args
      type:floating_message
      floating_message:User successfully added to role
      floating_state:success

// Returning success
return
   result:success
