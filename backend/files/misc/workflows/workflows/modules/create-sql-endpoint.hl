
/*
 * Executable Hyperlambda file that generates one HTTP endpoint executing a custom parametrised
 * SQL statement, using the same battle tested SQL endpoint generator the dashboard is using.
 * Use it to expose hand written SQL - reports, aggregates, joins, KPIs - as an HTTP endpoint.
 * Generated endpoints are instantly available as HTTP endpoints and MCP tools. Retrieve the
 * schema with get-database-schema first to get table and column names correct, and create the
 * module with create-module unless it already exists.
 */
.arguments

   // Mandatory argument being name of database to execute the SQL towards, e.g. 'chinook'.
   database:string

   // Optional argument being database type. Can be either 'mysql', 'pgsql', 'mssql' or 'sqlite'. Defaults to 'sqlite'.
   database-type:string

   // Optional connection string to use to connect. Defaults to 'generic'.
   connection-string:string

   // Mandatory argument being name of module to generate the endpoint inside of.
   moduleName:string

   // Mandatory argument being relative URL of the generated endpoint, without verb and extension - its full URL becomes 'moduleName/moduleUrl'.
   moduleUrl:string

   // Mandatory argument being HTTP verb of the generated endpoint. Can be either 'get', 'post', 'put', 'delete' or 'patch'. Use 'get' for endpoints reading data.
   verb:string

   // Mandatory argument being the SQL statement the endpoint executes, referencing endpoint arguments as @name, e.g. "select Name from Artist where Name like @filter". Returns rows as a list of objects.
   sql:string

   // Optional argument being argument declarations for the endpoint, as Hyperlambda 'name:type' pairs separated by newlines, e.g. "filter:string\nlimit:long". Types are Hyperlambda types - 'long', 'string', 'decimal', 'double', 'date' or 'bool'. Every declared argument is passed to the SQL, implying the SQL must reference each argument as @name, and callers must provide all of them when invoking the endpoint.
   arguments:string

   // Optional argument being comma separated list of roles allowed to invoke the endpoint. Omitting it creates an endpoint anyone can invoke.
   auth:string

   // Optional argument that if true will overwrite a previously generated endpoint file.
   overwrite:bool

// Ensuring user is root.
auth.ticket.verify:root

// Applying defaults.
validators.default:x:@.arguments
   database-type:sqlite
   connection-string:generic

// Connection strings name a configured connection, nothing more.
validators.regex:x:@.arguments/*/connection-string
   regex:^[a-z0-9_-]+$

// Sanity checking invocation.
validators.mandatory:x:@.arguments/*/database
validators.regex:x:@.arguments/*/database
   regex:^[a-z0-9_-]+$

/*
 * Assembling the '[connection-string|database]' reference the generator expects, the same way every
 * other database workflow does it - the caller names the database, and this file builds the
 * reference. Having callers assemble it themselves is what let unvalidated text through.
 */
strings.concat
   .:[
   get-value:x:@.arguments/*/connection-string
   .:|
   get-value:x:@.arguments/*/database
   .:]
set-value:x:@.arguments/*/database
   get-value:x:@strings.concat

/*
 * Translating to the names the generator declares. This file's arguments match crudify's, since
 * the two are used one after the other and differing names for the same thing is a trap - but the
 * generator underneath predates both and names three of them differently.
 */
unwrap:x:+/*
add:x:@.arguments
   .
      databaseType:x:@.arguments/*/database-type
      endpointName:x:@.arguments/*/moduleUrl
      authorization:x:@.arguments/*/auth
remove-nodes:x:@.arguments/*/database-type
remove-nodes:x:@.arguments/*/connection-string
remove-nodes:x:@.arguments/*/moduleUrl
remove-nodes:x:@.arguments/*/auth

// Passing arguments through to the SQL endpoint generator.
add:x:./*/execute-file
   get-nodes:x:@.arguments/*
execute-file:/system/crudifier/custom-sql.post.hl
return-nodes:x:@execute-file/*
