
/*
 * Executable Hyperlambda file that generates one HTTP endpoint executing a custom parametrised
 * SQL statement, using the same battle tested SQL endpoint generator the dashboard is using.
 * Use it to expose hand written SQL - reports, aggregates, joins, KPIs - as an HTTP endpoint.
 * Generated endpoints are instantly available as HTTP endpoints and MCP tools. Retrieve the
 * schema with get-database-schema first to get table and column names correct, and create the
 * module with create-module unless it already exists.
 */
.arguments

   // Mandatory argument being database type. Can be either 'mysql', 'pgsql', 'mssql' or 'sqlite'.
   databaseType:string

   // Mandatory argument being database to execute the SQL towards, on the format '[connection-string|database]', e.g. '[generic|chinook]'.
   database:string

   // Mandatory argument being name of module to generate the endpoint inside of.
   moduleName:string

   // Mandatory argument being name of the generated endpoint, without verb and extension - its relative URL becomes 'moduleName/endpointName'.
   endpointName:string

   // Mandatory argument being HTTP verb of the generated endpoint. Can be either 'get', 'post', 'put', 'delete' or 'patch'. Use 'get' for endpoints reading data.
   verb:string

   // Mandatory argument being the SQL statement the endpoint executes, referencing endpoint arguments as @name, e.g. "select Name from Artist where Name like @filter". Returns rows as a list of objects.
   sql:string

   // Optional argument being argument declarations for the endpoint, as Hyperlambda 'name:type' pairs separated by newlines, e.g. "filter:string\nlimit:long". Types are Hyperlambda types - 'long', 'string', 'decimal', 'double', 'date' or 'bool'. Every declared argument is passed to the SQL, implying the SQL must reference each argument as @name, and callers must provide all of them when invoking the endpoint.
   arguments:string

   // Optional argument being comma separated list of roles allowed to invoke the endpoint. Omitting it creates an endpoint anyone can invoke.
   authorization:string

   // Optional argument that if true will overwrite a previously generated endpoint file.
   overwrite:bool

// Ensuring user is root.
auth.ticket.verify:root

// Passing arguments through to the SQL endpoint generator.
add:x:./*/execute-file
   get-nodes:x:@.arguments/*
execute-file:/system/crudifier/custom-sql.post.hl
return-nodes:x:@execute-file/*
