/*
 * Creates an image
 *
 * Creates an image using DALL-E 3 according to the specified [prompt], [size], and [style], and returns to caller.
 * The return value will be the URL for the generated image, in addition to a description of the image.
 */
.arguments

   // Injected by the framework.
   _session:string

   // Mandatory and is the prompt used to generate the image.
   prompt:string

   // Optional and will default to '1024x1024' if not specified. Legal are 1024x1024, 1792x1024, and 1024x1792.
   size:string

   // Optional and will default to 'vivid' if not specified. Legal values are 'vivid' and 'natural'.
   style:string

// Sanity checking invocation.
validators.mandatory:x:@.arguments/*/prompt

// Applying defaults.
validators.default:x:@.arguments
   size:1024x1024
   style:vivid

/*
 * Invokes OpenAI's image generation API with the specified [query] and [model].
 *
 * Will use the default API key found from configurations.
 */
execute:magic.workflows.actions.execute
   name:openai-image-create
   filename:/modules/openai/workflows/actions/openai-image-create.hl
   arguments
      model:dall-e-3
      size:x:@.arguments/*/size
      style:x:@.arguments/*/style
      query:x:@.arguments/*/prompt

// Signaling frontend
sockets.signal:x:@.arguments/*/_session
   args
      type:floating_message
      floating_message:Image was successfully generated
      floating_state:success

// Returns the result of your last action.
return-nodes:x:@execute/*