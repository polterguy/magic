
/*
 * Call this FIRST, once, at the very start of every session. It returns who you are operating as
 * (username, roles, name, email), the backend URL, the current UTC date and time, AND your full
 * operating instructions. Ground yourself in this before doing anything else; never guess these values.
 */
.arguments

// Requiring an authenticated caller - this returns their own identity.
auth.ticket.verify

// Resolving the authenticated identity.
auth.ticket.get

// Reading the user's name and email from the users_extra table.
.name
.email
data.connect:magic
   data.read
      table:users_extra
      columns
         type
         value
      where
         and
            user.eq:x:@auth.ticket.get
   for-each:x:@data.read/*
      switch:x:@.dp/#/*/type
         case:name
            set-value:x:@.name
               get-value:x:@.dp/#/*/value
         case:email
            set-value:x:@.email
               get-value:x:@.dp/#/*/value

// Building the backend URL. Hardcoding https - behind a TLS proxy the internal request scheme is http.
.backend-url
set-value:x:@.backend-url
   strings.concat
      .:"https://"
      request.host

// Current UTC date and time.
date.now
date.format:x:@date.now
   format:"yyyy-MM-ddTHH:mm:ssZ"

// Returning the resolved session context.
.result
   date
   backend_url
   username
   name
   email
   roles
   instructions
set-value:x:@.result/*/date
   get-value:x:@date.format
set-value:x:@.result/*/backend_url
   get-value:x:@.backend-url
set-value:x:@.result/*/username
   get-value:x:@auth.ticket.get
set-value:x:@.result/*/name
   get-value:x:@.name
set-value:x:@.result/*/email
   get-value:x:@.email
add:x:@.result/*/roles
   get-nodes:x:@auth.ticket.get/*/roles/*

// Carrying the operating instructions in the result too, so clients that ignore the MCP [instructions]
// field (e.g. claude.ai) still receive them via this tool's output.
set-value:x:@.result/*/instructions
   io.file.load:/modules/mcp/system-instruction.md
return-nodes:x:@.result/*
