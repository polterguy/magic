
/*
 * Returns the full Markdown text of a single how-to guide.
 *
 * Pass the guide's name without extension as [name]; returns its text as [content], or throws
 * a public 404 if no such guide exists.
 */
.arguments

   // Mandatory argument being name of guide to read, without its file extension.
   name:string
// Ensuring user is root.
auth.ticket.verify:root
validators.mandatory:x:@.arguments/*/name
strings.concat
   .:/modules/mcp/guides/
   get-value:x:@.arguments/*/name
   .:.md
if
   not
      io.file.exists:x:@strings.concat
   .lambda
      throw:No such guide
         public:bool:true
         status:int:404
io.file.load:x:@strings.concat
yield
   content:x:@io.file.load
