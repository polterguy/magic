
/*
 * Generates a cryptographically secured random string, always at least 20 characters long, usable
 * for instance as a password.
 */
.arguments

// Ensuring user is root.
auth.ticket.verify:root

// Generating a cryptographically secure random string.
crypto.random
   min:20
   max:30

// Returning result to caller.
yield
   secret:x:@crypto.random
