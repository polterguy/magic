
/*
 * Executes the specified Python code, given either as raw [code] or as a [file] to execute.
 */
.arguments

   // Injected by the framework.
   _session:string

   // Optional full file name and path for code to execute. Supply either this or [code].
   file:string

   // Optional code to execute. Supply either this or [file].
   code:string

   // Optional positional arguments to execution.
   args:*

   // Optional string passed to stdin
   stdin:string

   // Optional working directory for execution of code.
   working-directory:string

   // Optional timeout for execution. Defaults to 30 seconds.
   timeout:int

// Ensuring user is root.
auth.ticket.verify:root

// Applying defaults.
validators.default:x:@.arguments
   timeout:int:30

// Parametrising invocation.
add:x:./*/python.execute
   get-nodes:x:@.arguments/*/file
   get-nodes:x:@.arguments/*/code
   get-nodes:x:@.arguments/*/args
   get-nodes:x:@.arguments/*/stdin
   get-nodes:x:@.arguments/*/timeout
   get-nodes:x:@.arguments/*/working-directory

// Executing Python code
python.execute

// Signaling frontend
sockets.signal:x:@.arguments/*/_session
   args
      type:floating_message
      floating_message:Python code successfully executed
      floating_state:success

// Returning result to caller.
yield
   result:x:@python.execute
