
/*
 * Adds the specified [filename] widget to the specified [type] as an HTML widget with the
 * specified [prompt]. The widget becomes a tool of its own on the type, described by [prompt],
 * whose parameters are the [[placeholder]] tokens in the widget's HTML.
 */
.arguments

   // Injected by the framework.
   _session:string

   // Mandatory name of type.
   type:string

   // Mandatory prompt for widget
   prompt:string

   // Mandatory widget file.
   filename:string

// Ensuring user is root.
auth.ticket.verify:root

// Sanity checking invocation.
validators.mandatory:x:@.arguments/*/type
validators.regex:x:@.arguments/*/type
   regex:^[a-z0-9_-]+$
validators.mandatory:x:@.arguments/*/prompt
validators.mandatory:x:@.arguments/*/filename

// Making sure file exists.
if
   not
      io.file.exists:x:@.arguments/*/filename
   .lambda
      throw:Widget file does not exist
         status:int:404
         public:bool:true

// Making sure widget is a valid widget
io.file.load:x:@.arguments/*/filename
if
   not
      strings.contains:x:@io.file.load
         .:WIDGET_ID_UNIQUE_NUMBER
   .lambda
      throw:Specified file is not a valid widget
         status:int:400
         public:bool:true

// Makes sure we don't try to add widgets outside of modules.
if
   not
      strings.starts-with:x:@.arguments/*/filename
         .:/modules/
   .lambda
      throw:"You can only add widgets that are inside of the /modules/ folder, where xyz is your module's name. Use fully qualitifed paths, including '/module/' and the module's name."
         status:int:400
         public:bool:true

// The snippet's text, shown in the training data and part of the tool's description.
.completion
set-value:x:@.completion
   strings.concat
      .:"HTML widget at "
      get-value:x:@.arguments/*/filename
      .:.

// Opening database.
data.connect:magic

   // Inserting our item.
   strings.concat
      .:"WIDGET ==> "
      get-value:x:@.arguments/*/filename
   data.create
      table:ml_training_snippets
      values
         type:x:@.arguments/*/type
         prompt:x:@.arguments/*/prompt
         completion:x:@.completion
         meta:x:@strings.concat

   // Signaling frontend
   sockets.signal:x:@.arguments/*/_session
      args
         type:floating_message
         floating_message:Widget successfully added to machine learning type
         floating_state:success

   // Returning result to caller.
   yield
      id:x:@data.create
