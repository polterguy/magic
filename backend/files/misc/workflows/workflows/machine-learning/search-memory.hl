
/*
 * Searches memories by what is asked, combining keyword search (BM25) with search by meaning
 * (vectors), and returns the best matches first, each with its [id], [prompt], [completion],
 * [uri] and [meta]. The [id] is what [update-memory] and [delete-memory] take. A collection
 * that is keyword only is searched by keyword alone, and needs no OpenAI key.
 */
.arguments

   // Mandatory text to search for, in natural language or as keywords such as names, URLs and identifiers.
   query:string

   // Optional name of the collection to search. Defaults to the type named default.
   type:string

   // Optional URL or reference to restrict the search to, such as the endpoint a Hyperlambda snippet was written for.
   uri:string

   // Optional maximum number of memories to return. Defaults to 5.
   limit:int

   // Optional similarity cutoff between 0 and 1, where a lower value is stricter. Defaults to the collection's own.
   threshold:decimal

// Ensuring user is root.
auth.ticket.verify:root

// Sanity checking invocation.
validators.mandatory:x:@.arguments/*/query
validators.default:x:@.arguments
   type:default
   limit:int:5

// Searching, which is shared with every other way of searching a type.
execute-file:/system/openai/search-snippets.hl
   type:x:@.arguments/*/type
   query:x:@.arguments/*/query
   threshold:x:@.arguments/*/threshold
   limit:x:@.arguments/*/limit
   uri:x:@.arguments/*/uri

// Returning the best matches first.
return-nodes:x:@execute-file/*
