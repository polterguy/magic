
/*
 * Declares the Hyperlambda file [filename] as an AI function on the machine learning type [type],
 * such that the type's model can execute it as a tool. The tool's description and arguments come
 * from the file itself, so the file should carry a leading comment and a comment above each argument.
 *
 * By default the declaration is stored as a training snippet on the type, with [prompt] and
 * [completion] as its human readable title and text. With [system_instruction] the declaration
 * is instead appended to the type's system instruction, as a single line under a Functions heading.
 */
.arguments

   // Injected by the framework.
   _session:string

   // Mandatory name of type.
   type:string

   // Mandatory single-line title of the function, shown in the training data.
   prompt:string

   // Mandatory human readable text about the function, shown in the training data.
   completion:string

   // Mandatory AI function file.
   filename:string

   // Optional argument. If true, adds the AI function declaration to the system instruction.
   system_instruction:bool

// Ensuring user is root.
auth.ticket.verify:root

// Adding defaults
validators.default:x:@.arguments
   system_instruction:bool:false

// Sanity checking invocation.
validators.mandatory:x:@.arguments/*/type
validators.mandatory:x:@.arguments/*/prompt
validators.mandatory:x:@.arguments/*/completion
validators.regex:x:@.arguments/*/type
   regex:^[a-z0-9_-]+$
validators.mandatory:x:@.arguments/*/filename

// Checking if we're to add it to the system instruction or not.
if
   neq:x:@.arguments/*/system_instruction
      .:bool:true
   .lambda

      // Creating meta value.
      .meta
      set-value:x:@.meta
         strings.concat
            .:"FUNCTION_INVOCATION ==> "
            get-value:x:@.arguments/*/filename

      // Inserting training snippet into database.
      data.connect:magic
         data.create
            table:ml_training_snippets
            values
               type:x:@.arguments/*/type
               prompt:x:@.arguments/*/prompt
               completion:x:@.arguments/*/completion
               meta:x:@.meta

         // Signaling frontend
         sockets.signal:x:@.arguments/*/_session
            args
               type:floating_message
               floating_message:AI function successfully declared on type
               floating_state:success

         // Returning result to caller.
         yield
            result:success
            id:x:@data.create

else

   // Adding it to the system instruction, under a Functions heading added the first time.
   data.connect:magic
      data.read
         table:ml_types
         where
            and
               type.eq:x:@.arguments/*/type
      if
         not-exists:x:@data.read/*
         .lambda
            throw:No such machine learning type
               public:bool:true
               status:int:400
      .instruction
      set-value:x:@.instruction
         strings.trim:x:@data.read/*/*/system_message
      if
         not
            strings.contains:x:@.instruction
               .:"## Functions"
         .lambda
            set-value:x:@.instruction
               strings.concat
                  get-value:x:@.instruction
                  .:"\n\n## Functions\n"
      set-value:x:@.instruction
         strings.concat
            get-value:x:@.instruction
            .:"\nFUNCTION_INVOCATION["
            get-value:x:@.arguments/*/filename
            .:]
      data.update
         table:ml_types
         where
            and
               type.eq:x:@.arguments/*/type
         values
            system_message:x:@.instruction

   // Signaling frontend
   sockets.signal:x:@.arguments/*/_session
      args
         type:floating_message
         floating_message:AI function successfully declared in the system instruction
         floating_state:success

   // Returning result to caller.
   yield
      result:success
