
/*
 * Returns all models from OpenAI, including fine tuned models.
 */
.type:internal
.description:Returns all models from OpenAI, including fine tuned models
.arguments
   api_key:string

// Making sure user has access to invoked endpoint.
auth.ticket.verify:root

/*
 * Creating our Bearer token by reading our OpenAI
 * configuration settings.
 */
.token
set-value:x:@.token
   strings.concat
      .:"Bearer "
      get-first-value
         get-value:x:@.arguments/*/api_key
         config.get:"magic:openai:key"

// Creating an HTTP POST request towards OpenAI, now decorated.
http.get:"https://api.openai.com/v1/models"
   headers
      Authorization:x:@.token
   convert:true

// Sanity checking above invocation
if
   neq:x:@http.get
      .:int:200
   .lambda

      // Oops, error - Logging error and returning status 500 to caller.
      lambda2hyper:x:@http.get
      log.error:Something went wrong while invoking OpenAI
         error:x:@lambda2hyper
      response.status.set:500
      return
         message:Something went wrong while invoking OpenAI, check your log for details

// Adding token count to models we know token count for.
for-each:x:@http.get/*/content/*/data/*

   switch:x:@.dp/#/*/id

      /*
       * gpt-5.2 is the oldest generation offered. The chat slot speaks only the
       * Responses API with reasoning, which everything below it lacks, so older
       * models are not offered for selection.
       *
       * [input_price] and [output_price] are USD per 1,000,000 tokens, surfaced
       * so the dashboard can show cost in the model dropdowns. A couple of
       * variants with no reliably published price simply omit them.
       */
      // Only 1536-dimension embedding models are compatible with the fixed
      // vector_init('...dimension=1536...') index; text-embedding-3-large is
      // 3072-dim, so it is intentionally excluded.
      case:text-embedding-3-small
      case:text-embedding-ada-002
         add:x:@.dp/#
            .
               vector:bool:true

      case:gpt-5.2
         add:x:@.dp/#
            .
               tokens:int:400000
               chat:bool:true
               input_price:decimal:0.88
               output_price:decimal:7

      case:gpt-5.2-pro
         add:x:@.dp/#
            .
               tokens:int:400000
               chat:bool:true

      case:gpt-5.3-codex
         add:x:@.dp/#
            .
               tokens:int:400000
               chat:bool:true
               input_price:decimal:1.75
               output_price:decimal:14

      case:gpt-5.4
         add:x:@.dp/#
            .
               tokens:int:1000000
               chat:bool:true
               input_price:decimal:2.5
               output_price:decimal:15

      case:gpt-5.4-pro
      case:gpt-5.5-pro
         add:x:@.dp/#
            .
               tokens:int:1000000
               chat:bool:true
               input_price:decimal:30
               output_price:decimal:180

      case:gpt-5.5
         add:x:@.dp/#
            .
               tokens:int:1000000
               chat:bool:true
               input_price:decimal:5
               output_price:decimal:30

      case:gpt-5.4-mini
         add:x:@.dp/#
            .
               tokens:int:400000
               chat:bool:true
               input_price:decimal:0.75
               output_price:decimal:4.5

      case:gpt-5.4-nano
         add:x:@.dp/#
            .
               tokens:int:400000
               chat:bool:true
               input_price:decimal:0.2
               output_price:decimal:1.25

      case:gpt-5.6-sol
         add:x:@.dp/#
            .
               tokens:int:1050000
               chat:bool:true
               input_price:decimal:5
               output_price:decimal:30

      // Terra and Luna prices are the July 30, 2026 cuts; Sol never moved.
      case:gpt-5.6-terra
         add:x:@.dp/#
            .
               tokens:int:1050000
               chat:bool:true
               input_price:decimal:2
               output_price:decimal:12

      case:gpt-5.6-luna
         add:x:@.dp/#
            .
               tokens:int:1050000
               chat:bool:true
               input_price:decimal:0.2
               output_price:decimal:1.2

      case:gpt-6-astra
         add:x:@.dp/#
            .
               tokens:int:1050000
               chat:bool:true
               input_price:decimal:10
               output_price:decimal:50

/*
 * Applying some HTTP caching to avoid invoking OpenAI again with
 * the same question before some minimum amount of time has passed.
 */
response.headers.set
   Cache-Control:private, max-age=3600

/*
 * Returning models to caller newest first, using OpenAI's own creation
 * timestamps, such that dropdowns lead with the current generation.
 */
sort:x:@http.get/*/content/*/data/*
   if
      mt:x:@.lhs/#/*/created
         get-value:x:@.rhs/#/*/created
      .lambda
         set-value:x:@.result
            .:int:-1
   else-if
      lt:x:@.lhs/#/*/created
         get-value:x:@.rhs/#/*/created
      .lambda
         set-value:x:@.result
            .:int:1
   else
      set-value:x:@.result
         .:int:0
add:x:../*/return
   get-nodes:x:@sort/*
return
