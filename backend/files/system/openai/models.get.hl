
/*
 * Returns the OpenAI models Magic supports, with context window and prices, from the
 * static model-catalogue.hl. Never asks OpenAI, so it works before an API key exists.
 */
.type:internal
.description:Returns the OpenAI models Magic supports, with context window and prices

// Making sure user has access to invoked endpoint.
auth.ticket.verify:root

// Loading catalogue.
io.file.load:/system/openai/model-catalogue.hl
hyper2lambda:x:@io.file.load

// Returning models to caller, newest first as listed in the catalogue.
return-nodes:x:@hyper2lambda/*
