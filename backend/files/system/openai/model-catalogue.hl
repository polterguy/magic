
/*
 * The one list of OpenAI models Magic supports, newest first. Everything that needs to know
 * which models exist, their context window or what they cost reads this file - models.get.hl
 * serves it to the frontend, magic.ai.endpoint-common.hl takes its context window from it and
 * migrate-deprecated-models.hl treats every entry with [chat] as supported.
 *
 * Only models spoken to over the Responses API with reasoning are listed, which is gpt-5.2 and
 * up. [tokens] is the context window, and [input_price] and [output_price] are USD per
 * 1,000,000 tokens at the standard tier for requests up to 272K input tokens. Only 1536
 * dimension embedding models are listed since the vector index is fixed at that size, and
 * text-embedding-3-large is 3072.
 */
.
   id:gpt-6-astra
   tokens:int:1050000
   chat:bool:true
   input_price:decimal:10
   output_price:decimal:50
.
