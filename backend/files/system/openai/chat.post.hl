
/*
 * OpenAI chat endpoint, for having conversations with OpenAI's models over the Responses API.
 *
 * Notice, if you set [stream] to true the endpoint will stream response tokens over the specified
 * [session] back to caller.
 */
.arguments
   prompt:string
   type:string
   references:bool
   chat:bool
   permanent:bool
   recaptcha_response:string
   user_id:string
   session:string
   stream:bool
   data:string
   referrer:string
   extra:string
   file:*
   upload_file_only:bool
   system_message_override:string
   meta:string
.description:@"OpenAI chat endpoint, for having conversations with OpenAI's models"
.type:public

// Forwarding to get Hyperlambda file.
add:x:+
   get-nodes:x:@.arguments/*
execute-file:/system/openai/chat.get.hl

// Returning result to caller.
return-nodes:x:-/*
