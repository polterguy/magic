
/*
 * Executes the Hyperlambda [file] a tool call resolved to, with the JSON [arguments] the model
 * supplied, and returns whatever the file returns back to the caller.
 *
 * The caller is responsible for verifying the type declares the file. The chat slot resolves tool
 * names against the functions it declared to the model, so the model can only execute what the
 * type declares.
 *
 * If the file declares [_session], [_user-id], [_type], [_extra] or [_base_url] arguments, the slot
 * supplies these from its own [session], [user-id], [type], [extra] and [base_url] arguments, such
 * that functions can execute in the context of the user and session that triggered them.
 */
slots.create:magic.ai.functions.invoke

   // Sanity checking invocation.
   validators.mandatory:x:@.arguments/*/type
   validators.mandatory:x:@.arguments/*/file

   // Parametrising invocation with the model's arguments, if it supplied any.
   if
      and
         not-null:x:@.arguments/*/arguments
         neq:x:@.arguments/*/arguments
            .:
      .lambda

         json2lambda:x:@.arguments/*/arguments

         /*
          * Removing [session] and [user-id] from JSON arguments, to avoid applying these twice,
          * in case user didn't correctly prompt engineer the AI function.
          */
         remove-nodes:x:@json2lambda/*/_session
         remove-nodes:x:@json2lambda/*/_user-id
         remove-nodes:x:@json2lambda/*/_type
         remove-nodes:x:@json2lambda/*/_extra
         remove-nodes:x:@json2lambda/*/_base_url

         // Adding arguments to [execute-file].
         add:x:../*/execute-file
            get-nodes:x:@json2lambda/*

   /*
    * Loading file and transforming to lambda to see if the file requires a [_session], [_user-id], [_base_url] or [_type] arguments,
    * at which point we add the current [_session] value, the current [_user-id] value and the current [_type] value to its invocation.
    */
   load-file:x:@.arguments/*/file
   hyper2lambda:x:@load-file

   // Checking if we've got a [_base_url] argument.
   if
      exists:x:@hyper2lambda/*/.arguments/*/_base_url/=string
      .lambda

         /*
          * File requires a [_base_url] and it is of type string, making sure we pass
          * in [_base_url] argument given to invocation.
          */
         unwrap:x:+/*/*
         add:x:../*/execute-file
            .
               _base_url:x:@.arguments/*/base_url

   // Checking if we've got a [_session] argument.
   if
      exists:x:@hyper2lambda/*/.arguments/*/_session/=string
      .lambda

         /*
          * File requires a [_session] and it is of type string, making sure we pass
          * in [_session] argument given to invocation.
          */
         unwrap:x:+/*/*
         add:x:../*/execute-file
            .
               _session:x:@.arguments/*/session

   // Checking if we've got a [_user-id] argument.
   if
      exists:x:@hyper2lambda/*/.arguments/*/_user-id/=string
      .lambda

         /*
          * File requires a [_user-id] and it is of type string, making sure we pass
          * in [_user-id] argument given to invocation.
          */
         unwrap:x:+/*/*
         add:x:../*/execute-file
            .
               _user-id:x:@.arguments/*/user-id

   // Checking if we've got a [_extra] argument.
   if
      exists:x:@hyper2lambda/*/.arguments/*/_extra/=string
      .lambda

         /*
          * File requires a [_extra] and it is of type string, making sure we pass
          * in [_extra] argument given to invocation.
          */
         unwrap:x:+/*/*
         add:x:../*/execute-file
            .
               _extra:x:@.arguments/*/extra

   // Checking if we've got a [_type] argument.
   if
      exists:x:@hyper2lambda/*/.arguments/*/_type/=string
      .lambda

         /*
          * File requires a [_type] and it is of type string, making sure we pass
          * in [_type] argument given to invocation.
          */
         unwrap:x:+/*/*
         add:x:../*/execute-file
            .
               _type:x:@.arguments/*/type

   // Executing file.
   execute-file:x:@.arguments/*/file

   // Doing some basic logging.
   log.info:Function invocation succeeded
      type:x:@.arguments/*/type
      function-file:x:@.arguments/*/file

   // Returning result of invocation to caller.
   add:x:./*/yield/*/result
      get-nodes:x:@execute-file/*
   set-value:x:./*/yield/*/result
      get-value:x:@execute-file
   yield
      result
