
/*
 * Returns Markdown training snippet from specified [html].
 *
 * Takes the following arguments:
 *
 * - [html]   - Mandatory. Being the actual HTML we're traversing for training data.
 * - [url]    - Mandatory. Being the URL from where the document was fetched.
 * - [images] - Optional. If true images are kept in the Markdown. Defaults to true.
 */
slots.create:magic.ai.html.extract

   // Sanity checking invocation.
   validators.mandatory:x:@.arguments/*/html
   validators.mandatory:x:@.arguments/*/url
   validators.url:x:@.arguments/*/url

   // Ensuring defaults.
   validators.default:x:@.arguments
      images:bool:true

   // Buffer used for snippet to return.
   .snippets

   // Buffer for title.
   .title

   // Buffer for description.
   .description

   // Buffer used for URLs from HTML document.
   .urls

   /*
    * Converting the whole document to Markdown.
    *
    * This is only used to harvest the page's title, description and URLs.
    * The URLs come deliberately from the WHOLE document, since the links the
    * crawler follows to find the rest of the site live in the navigation.
    */
   html2markdown:x:@.arguments/*/html
      url:x:@.arguments/*/url
      images:x:@.arguments/*/images
      lists:bool:true
      code:bool:true

   // Checking if we have any Markdown at all, and if not we return early.
   if
      or
         null:x:@html2markdown
         eq:x:@html2markdown
            .:
      .lambda

         // Nothing to do here ...
         return
            urls
            snippets

   // Retrieving title and description from document.
   set-value:x:@.title
      get-value:x:@html2markdown/*/title/[0,1]
   set-value:x:@.description
      get-value:x:@html2markdown/*/description/[0,1]

   // Adding URLs found as we transformed HTML to Markdown.
   add:x:@.urls
      get-nodes:x:@html2markdown/*/urls/*

   // Prompt for the page's training snippet.
   .prompt
   set-value:x:@.prompt
      get-first-value
         get-value:x:@.title
         get-value:x:@.description
         .:"Page"

   /*
    * Selecting the part of the document the snippet is built from.
    *
    * The author's own markup decides: [main] is unique per page and declared
    * to contain all primary content, so it wins when it exists. With no main,
    * every [article] is used. With neither, the whole [body] is used - text
    * is only ever selected, never removed.
    */
   html2lambda:x:@.arguments/*/html
   .content
   if
      exists:x:@html2lambda/*/html/*/body/**/main
      .lambda
         set-value:x:@.content
            lambda2html:x:@html2lambda/*/html/*/body/**/main
   else-if
      exists:x:@html2lambda/*/html/*/body/**/article
      .lambda
         set-value:x:@.content
            lambda2html:x:@html2lambda/*/html/*/body/**/article
   else
      set-value:x:@.content
         lambda2html:x:@html2lambda/*/html/*/body

   // Converting the selected content to Markdown.
   .completion
   html2markdown:x:@.content
      url:x:@.arguments/*/url
      images:x:@.arguments/*/images
      lists:bool:true
      code:bool:true
   if
      not-null:x:@html2markdown
      .lambda
         set-value:x:@.completion
            strings.trim:x:@html2markdown
               .:"\r\n\t "

   /*
    * Returning the page as one training snippet, unless it turned out to be
    * empty - single page applications rendering client side typically return
    * an HTML shell without content, and the caller warns the user whenever we
    * return zero snippets.
    */
   if
      and
         not-null:x:@.completion
         neq:x:@.completion
            .:
      .lambda
         unwrap:x:+/*/*/*
         add:x:@.snippets
            .
               .
                  prompt:x:@.prompt
                  completion:x:@.completion

   // Returning snippets and URLs to caller.
   add:x:./*/return/*/snippets
      get-nodes:x:@.snippets/*
   add:x:./*/return/*/urls
      get-nodes:x:@.urls/*
   return
      urls
      snippets
