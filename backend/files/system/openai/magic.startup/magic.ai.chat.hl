
/*
 * Chat slot for having conversations with OpenAI's models over the Responses API.
 *
 * Every AI function the type declares is handed to the model as a native tool, and the slot
 * executes the function calls the model returns, feeding their outputs back to the model until
 * it answers with text.
 */
slots.create:magic.ai.chat

   // Applying defaults.
   validators.default:x:@.arguments
      stream:bool:false

   // Retrieving relevant snippets.
   .context-buffer
   if
      eq
         convert:x:@.arguments/*/use_embeddings
            type:int
         .:int:1
      .lambda
         unwrap:x:+/*
         signal:magic.ai.get-context
            type:x:@.arguments/*/type
            prompt:x:@.arguments/*/prompt
            threshold:x:@.arguments/*/threshold
            max_tokens:x:@.arguments/*/max_context_tokens
            api_key:x:@.arguments/*/api_key
            search_postfix:x:@.arguments/*/search_postfix
            session:x:@.arguments/*/session
            session_timeout:x:@.arguments/*/session_timeout
            meta:x:@.arguments/*/meta
         add:x:@.context-buffer
            get-nodes:x:@signal/*

   /*
    * Session for user containing previous questions and answers,
    * in addition to context and system message.
    */
   .session

   // Making sure user doesn't inject mixin logic in system message override.
   if
      and
         exists:x:@.arguments/*/system_message_override
         strings.contains:x:@.arguments/*/system_message_override
            .:{{
      .lambda
         throw:System message override contains mixin logic which is not allowed.
            public:bool:true
            status:int:400

   // Checking if we've got a system message.
   .tmp_system
   set-value:x:@.tmp_system
      get-first-value
         get-value:x:@.arguments/*/system_message_override
         get-value:x:@.arguments/*/system_message
   if
      and
         not-null:x:@.tmp_system
         neq:x:@.tmp_system
            .:
      .lambda

         /*
          * Function declarations are transport, not instructions. Each FUNCTION_INVOCATION[...] line
          * was already read for the tool catalogue, and the model gets the function as a tool, so the
          * lines themselves are dropped from what it reads. Old protocol prose around them is gone
          * from the stored text since migrate-system-messages.hl ran at startup.
          */
         set-value:x:@.tmp_system
            strings.regex-replace:x:@.tmp_system
               .:"(?m)^.*FUNCTION_INVOCATION.*\\n?"
               .:

         // Adding system message to [.session]
         unwrap:x:+/*/*/*/content
         add:x:@.session
            .
               .
                  role:system
                  content:x:@.tmp_system

   // Then adding context ml_requests belonging to user to [.session]
   data.connect:[generic|magic]

      // Selecting context requests from database.
      data.select:@"
select prompt, max(completion) as completion
   from ml_requests
   where user_id = @user_id and questionnaire = 1 and context = 1
   group by prompt"
         user_id:x:@.arguments/*/user_id

      // Adding context requests to [.session].
      for-each:x:@data.select/*

         // Adding question as system message.
         unwrap:x:+/*/*/*/content
         add:x:@.session
            .
               .
                  role:assistant
                  content:x:@.dp/#/*/prompt

         // Adding answer as user message.
         unwrap:x:+/*/*/*/content
         add:x:@.session
            .
               .
                  role:user
                  content:x:@.dp/#/*/completion

   /*
    * Storing how many fixed messages we have to avoid removing
    * system message or questionnaire messages as we're pruning messages
    * to avoid overflowing model.
    */
   .fixed
   set-value:x:@.fixed
      get-count:x:@.session/*

   /*
    * How many leading messages must never be written back to the session cache.
    *
    * That is the fixed messages above - which are re-created from the type and
    * the database on every request - plus this request's context if we have
    * any, since context is retrieved fresh for every question too. Caching the
    * context would stack one stale context block per message, until the session
    * is nothing but old context.
    *
    * Kept apart from [.fixed] because the two answer different questions:
    * [.fixed] is what pruning may not touch, this is what caching must drop.
    */
   .no-cache
   set-value:x:@.no-cache
      get-value:x:@.fixed

   // Checking if we've got context.
   if
      not-null:x:@.context-buffer/*/context
      .lambda

         // Adding context to above [.session].
         unwrap:x:+/*/*/*/content
         add:x:@.session
            .
               .
                  role:system
                  content:x:@.context-buffer/*/context
         math.increment:x:@.no-cache

   /*
    * Retrieving session items.
    */
   cache.get:x:@.arguments/*/session
   if
      not-null:x:@cache.get
      .lambda

         // We've got existing session items.
         hyper2lambda:x:@cache.get
         add:x:@.session
            get-nodes:x:@hyper2lambda/*

   // Checking if we've got a [data] argument, and if so, making sure we accommodate for token size.
   .extra-tokens:int:0
   if
      and
         exists:x:@.arguments/*/data
         not-null:x:@.arguments/*/data
         neq:x:@.arguments/*/data
            .:
      .lambda
         set-value:x:@.extra-tokens
            openai.tokenize:x:@.arguments/*/data

   // Checking if we've got a [data] argument, and if so, adding it.
   if
      and
         exists:x:@.arguments/*/data
         not-null:x:@.arguments/*/data
         neq:x:@.arguments/*/data
            .:
      .lambda
         unwrap:x:+/*/*/*/content
         add:x:@.session
            .
               .
                  role:user
                  content:x:@.arguments/*/data

   // Adding user's current question to session.
   unwrap:x:+/*/*/*/content
   add:x:@.session
      .
         .
            role:user
            content:x:@.arguments/*/prompt

   /*
    * Pruning previous messages until size of context + max_tokens is less than whatever
    * amount of tokens the model can handle.
    */
   .cont:bool:true
   while:x:@.cont

      lambda2hyper:x:@.session/*
      if
         lt
            math.add
               get-value:x:@.arguments/*/max_tokens
               openai.tokenize:x:@lambda2hyper
               get-value:x:@.extra-tokens
            get-value:x:@.arguments/*/model_size
         .lambda

            // Context is small enough to answer according to max_tokens.
            set-value:x:@.cont
               .:bool:false

      else

         /*
          * We need to remove one of our previous messages to have OpenAI return max_tokens.
          * Notice, we only remove messages after our "fixed" messages, which are system message and
          * questionnaire messages.
          *
          * A function call and its output leave together, since OpenAI rejects an input holding
          * one without the other - so if the oldest message is a function call, everything sharing
          * its call_id goes with it.
          */
         .call-id
         strings.concat
            .:@.session/
            get-value:x:@.fixed
            .:/*/call_id
         set-x:x:./*/set-value/*/get-value
            convert:x:@strings.concat
               type:x
         set-value:x:@.call-id
            get-value
         if
            not-null:x:@.call-id
            .lambda
               remove-nodes:x:@.session/*/call_id/={@.call-id}/.
         else
            strings.concat
               .:@.session/
               get-value:x:@.fixed
            set-x:x:./*/remove-nodes
               convert:x:@strings.concat
                  type:x
            remove-nodes

   // Retrieving token used to invoke OpenAI.
   .token
   set-value:x:@.token
      strings.concat
         .:"Bearer "
         get-first-value
            get-value:x:@.arguments/*/api_key
            config.get:"magic:openai:key"

   // Checking if we've got file arguments.
   if
      exists:x:@.arguments/*/file
      .lambda

         /*
          * The client uploaded one or more files.
          * First checking if he only wants to save locally, or push to LLM.
          */
         if
            and
               exists:x:@.arguments/*/upload_file_only
               eq:x:@.arguments/*/upload_file_only
                  .:bool:true
            .lambda

               // Client only wants to upload files, making sure upload folder exists.
               if
                  not
                     io.folder.exists:/etc/www/tmp/
                  .lambda
                     io.folder.create:/etc/www/tmp/

               // Client only wants to upload. Building our "user uploaded files" message.
               .message:"User uploaded the following files;\n"
               while
                  exists:x:@.arguments/*/file/*
                  .lambda


                     // Creating a unique filename.
                     strings.split:x:@.arguments/*/file/[0,1]/*/name
                        .:.
                     .filename
                     set-value:x:-
                        strings.concat
                           .:/etc/www/tmp/
                           crypto.random
                              min:10
                              max:10
                           .:.
                           get-value:x:@strings.split/0/-
                     io.stream.save-file:x:@.filename
                        get-value:x:@.arguments/*/file/[0,1]/*/stream
                     set-value:x:@.message
                        strings.concat
                           get-value:x:@.message
                           .:"* "
                           get-value:x:@.filename
                           .:"\n"
                     remove-nodes:x:@.arguments/*/file/[0,1]

               // Injecting a system node before our last message.
               unwrap:x:+/*/*/*
               insert-before:x:@.session/0/-
                  .
                     .
                        role:system
                        content:x:@.message

         else

            // Client wants to upload, AND have LLM analyse files.

            /*
             * The [.tail] node is used as a buffer for holding URLs of all files.
             */
            .tail:"User uploaded the following files;\n"

            // Removing old message node first.
            remove-nodes:x:@.session/0/-

            // Adding file container message
            unwrap:x:+/*/**
            add:x:@.session
               .
                  .
                     role:user
                     content
                        .
                           type:input_text
                           text:x:@.arguments/*/prompt

            // Looping through all file arguments.
            while
               exists:x:@.arguments/*/file
               .lambda

                  // Can't upload images from localhost!!
                  request.host
                  if
                     strings.contains:x:@request.host
                        .:localhost
                     .lambda
                        throw:You cannot analyse images from localhost
                           status:int:400
                           public:bool:true

                  /*
                   * Saving files locally in etc folder to expose to LLM,
                   * using a random filename to ensure unique filenames.
                   *
                   * First making sure our tmp folder exists.
                   */
                  if
                     not
                        io.folder.exists:/etc/www/tmp/
                     .lambda
                        io.folder.create:/etc/www/tmp/

                  strings.split:x:@.arguments/*/file/[0,1]/*/name
                     .:.
                  .filename
                  set-value:x:-
                     strings.concat
                        .:/etc/www/tmp/
                        crypto.random
                           min:25
                           max:25
                        .:.
                        get-value:x:@strings.split/0/-
                  io.stream.save-file:x:@.filename
                     get-value:x:@.arguments/*/file/[0,1]/*/stream
                  set-value:x:@.tail
                     strings.concat
                        get-value:x:@.tail
                        .:"* "
                        get-value:x:@.filename
                        .:"\n"
                  .url
                  set-value:x:-
                     strings.concat
                        .:"https://"
                        request.host
                        .:/tmp/
                        strings.substring:x:@.filename
                           .:13
                  switch:x:@strings.split/0/-
                     case:png
                     case:PNG
                     case:jpg
                     case:JPG
                     case:jpeg
                     case:JPEG
                     case:webp
                     case:WEBP
                     case:gif
                     case:GIF
                        unwrap:x:+/*/**
                        add:x:@.session/0/-/*/content
                           .
                              .
                                 type:input_image
                                 image_url:x:@.url
                     default
                        unwrap:x:+/*/**
                        add:x:@.session/0/-/*/content
                           .
                              .
                                 type:input_file
                                 file_url:x:@.url
                  remove-nodes:x:@.arguments/*/file/[0,1]

            unwrap:x:+/*/*/*
            insert-before:x:@.session/0/-/*/content/0/-
               .
                  .
                     type:input_text
                     text:x:@.tail

   // Tool names mapped to the files they execute. Function calls are resolved against this.
   .functions

   /*
    * Checking if caller wants to stream tokens.
    *
    * Streaming implies using OpenAI's SSE features, where the
    * invocation returns immediately, for then to invoke our callback
    * as more tokens are available to our client.
    */
   if
      eq:x:@.arguments/*/stream
         .:bool:true
      .lambda

         // We're using streaming or SSE as we're invoking OpenAI.
         .host
         set-value:x:-
            strings.concat
               .:"https://"
               request.host

         /*
          * Declaring every AI function on the type as a native tool.
          *
          * A function is declared by a training snippet whose meta names its file, or by a
          * FUNCTION_INVOCATION reference in the type's system message, which are the two places the
          * dashboard writes declarations to. A reference to a file that doesn't exist is documentation,
          * such as the example found in the system message templates, and declares nothing. The default
          * type is the agent for building on the cloudlet, and when root is the one talking to it, it
          * additionally gets every workflow file as a tool - the same catalogue the MCP module hands
          * to root callers.
          *
          * The tool's name is the file's name, its description is the file's leading comment, and its
          * parameters come from the file's [.arguments] collection, with the comment above each
          * argument as its description. Arguments the invoker supplies itself are not exposed.
          *
          * Every HTML widget on the type is a tool of its own: its name comes from the widget file, its
          * description is the snippet's prompt and text, and its parameters are the [[placeholder]]
          * tokens in the HTML. Calling it renders that file through render-html-widget.
          */
         .declarations
         .widgets
         data.connect:[generic|magic]
            data.select:"select meta from ml_training_snippets where type = @type and meta like 'FUNCTION_INVOCATION ==> %'"
               @type:x:@.arguments/*/type
            for-each:x:@data.select/*
               strings.split:x:@.dp/#/*/meta
                  .:" ==> "
               unwrap:x:+/*/*/*
               add:x:@.declarations
                  .
                     .
                        file:x:@strings.split/1
            data.select:"select prompt, completion, meta from ml_training_snippets where type = @type and meta like 'WIDGET ==> %'"
               @type:x:@.arguments/*/type
            for-each:x:@data.select/*
               strings.split:x:@.dp/#/*/meta
                  .:" ==> "
               unwrap:x:+/*/*/*
               add:x:@.widgets
                  .
                     .
                        file:x:@strings.split/1
                        prompt:x:@.dp/#/*/prompt
                        completion:x:@.dp/#/*/completion
         if
            not-null:x:@.arguments/*/system_message
            .lambda
               strings.split:x:@.arguments/*/system_message
                  .:"FUNCTION_INVOCATION["
               remove-nodes:x:@strings.split/0
               for-each:x:@strings.split/*
                  strings.split:x:@.dp/#
                     .:]
                  unwrap:x:+/*/*/*
                  add:x:@.declarations
                     .
                        .
                           file:x:@strings.split/0
         if
            and
               auth.ticket.in-role:root
               eq:x:@.arguments/*/type
                  .:default
            .lambda

               /*
                * Workflow files that are not Chat Ops tools. whoami answers with the MCP operating
                * instructions, and reads the HTTP request, which the chat loop's thread doesn't have.
                */
               .excluded
                  .:/misc/workflows/workflows/misc/whoami.hl
               .folders
                  .:/misc/workflows/workflows/
                  .:/system/workflows/workflows/
               for-each:x:@.folders/*
                  io.file.list-recursively:x:@.dp/#
                  for-each:x:@io.file.list-recursively/*
                     if
                        and
                           strings.ends-with:x:@.dp/#
                              .:.hl
                           not
                              exists:x:@.excluded/*/={@.dp/#}
                        .lambda
                           unwrap:x:+/*/*/*
                           add:x:@.declarations
                              .
                                 .
                                    file:x:@.dp/#

         // Arguments the invoker supplies itself, and comment nodes, are not parameters.
         .hidden
            .:..
            .:_session
            .:_user-id
            .:_type
            .:_extra
            .:_base_url
         .tools
         for-each:x:@.declarations/*
            if
               and
                  io.file.exists:x:@.dp/#/*/file
                  not
                     exists:x:@.functions/*/*/file/={@.dp/#/*/file}
               .lambda

                  // The tool's name is the file's name, made legal for OpenAI by replacing dots with underscores.
                  strings.split:x:@.dp/#/*/file
                     .:/
                  strings.replace:x:@strings.split/0/-
                     .:.hl
                     .:
                  strings.replace:x:@strings.replace
                     .:.
                     .:_
                  .name
                  set-value:x:@.name
                     get-value:x:@strings.replace
                  if
                     exists:x:@.functions/*/*/name/={@.name}
                     .lambda
                        strings.concat
                           .:"Two AI functions on the type resolve to the same tool name: "
                           get-value:x:@.name
                        throw:x:@strings.concat
                           public:bool:true
                           status:int:400

                  load-file:x:@.dp/#/*/file
                  hyper2lambda:x:@load-file
                     comments:true

                  // The description is the file's own leading comment.
                  .description
                  if
                     eq
                        get-name:x:@hyper2lambda/0
                        .:..
                     .lambda
                        set-value:x:@.description
                           get-value:x:@hyper2lambda/0
                  else
                     set-value:x:@.description
                        .:No description available

                  .parameters
                     type:object
                  for-each:x:@hyper2lambda/*/.arguments/*
                     get-name:x:@.dp/#
                     if
                        not
                           exists:x:@.hidden/*/={@get-name}
                        .lambda

                           .jtype
                           .jformat
                           switch:x:@.dp/#
                              case:short
                              case:ushort
                              case:int
                              case:uint
                              case:long
                              case:ulong
                              case:byte
                              case:sbyte
                                 set-value:x:@.jtype
                                    .:integer
                              case:decimal
                              case:double
                              case:single
                              case:float
                                 set-value:x:@.jtype
                                    .:number
                              case:bool
                                 set-value:x:@.jtype
                                    .:boolean
                              case:date
                                 set-value:x:@.jtype
                                    .:string
                                 set-value:x:@.jformat
                                    .:date-time
                              case:guid
                                 set-value:x:@.jtype
                                    .:string
                                 set-value:x:@.jformat
                                    .:uuid
                              case:*
                                 set-value:x:@.jtype
                                    .:object
                              default
                                 set-value:x:@.jtype
                                    .:string

                           if
                              not-exists:x:@.parameters/*/properties
                              .lambda
                                 add:x:@.parameters
                                    .
                                       properties
                           unwrap:x:+/+/*/**
                           set-name:x:+/*/*
                              get-value:x:@get-name
                           add:x:@.parameters/*/properties
                              .
                                 name
                                    type:x:@.jtype
                           if
                              not-null:x:@.jformat
                              .lambda
                                 unwrap:x:+/*/*
                                 add:x:@.parameters/*/properties/0/-
                                    .
                                       format:x:@.jformat
                           if
                              eq
                                 get-name:x:@.dp/#/-
                                 .:..
                              .lambda
                                 unwrap:x:+/*/*
                                 add:x:@.parameters/*/properties/0/-
                                    .
                                       description:x:@.dp/#/-

                  unwrap:x:+/*/*/*
                  add:x:@.tools
                     .
                        .
                           type:function
                           name:x:@.name
                           description:x:@.description
                  add:x:@.tools/0/-
                     get-nodes:x:@.parameters
                  set-name:x:@.tools/0/-/*/.parameters
                     .:parameters
                  unwrap:x:+/*/*/*
                  add:x:@.functions
                     .
                        .
                           name:x:@.name
                           file:x:@.dp/#/*/file

         for-each:x:@.widgets/*
            if
               io.file.exists:x:@.dp/#/*/file
               .lambda

                  // The tool's name is the widget file's name, prefixed such that it cannot shadow a function.
                  strings.split:x:@.dp/#/*/file
                     .:/
                  strings.replace:x:@strings.split/0/-
                     .:.html
                     .:
                  strings.replace:x:@strings.replace
                     .:.
                     .:_
                  .name
                  set-value:x:@.name
                     strings.concat
                        .:widget_
                        get-value:x:@strings.replace
                  if
                     exists:x:@.functions/*/*/name/={@.name}
                     .lambda
                        strings.concat
                           .:"Two HTML widgets on the type resolve to the same tool name: "
                           get-value:x:@.name
                        throw:x:@strings.concat
                           public:bool:true
                           status:int:400

                  .description
                  set-value:x:@.description
                     strings.concat
                        get-value:x:@.dp/#/*/prompt
                        .:"\n\n"
                        get-value:x:@.dp/#/*/completion

                  // Every [[placeholder]] in the HTML is a string parameter, declared once.
                  .parameters
                     type:object
                  .names
                  io.file.load:x:@.dp/#/*/file
                  strings.split:x:@io.file.load
                     .:[[
                  remove-nodes:x:@strings.split/0
                  for-each:x:@strings.split/*
                     strings.split:x:@.dp/#
                        .:]]
                     if
                        and
                           exists:x:@strings.split/1
                           not
                              exists:x:@.names/*/={@strings.split/0}
                        .lambda
                           unwrap:x:+/*/*
                           add:x:@.names
                              .
                                 .:x:@strings.split/0
                           if
                              not-exists:x:@.parameters/*/properties
                              .lambda
                                 add:x:@.parameters
                                    .
                                       properties
                           set-name:x:+/*/*
                              get-value:x:@strings.split/0
                           add:x:@.parameters/*/properties
                              .
                                 name
                                    type:string
                                    description:Value for this placeholder in the widget.

                  unwrap:x:+/*/*/*
                  add:x:@.tools
                     .
                        .
                           type:function
                           name:x:@.name
                           description:x:@.description
                  add:x:@.tools/0/-
                     get-nodes:x:@.parameters
                  set-name:x:@.tools/0/-/*/.parameters
                     .:parameters
                  unwrap:x:+/*/*/*
                  add:x:@.functions
                     .
                        .
                           name:x:@.name
                           file:/misc/workflows/workflows/machine-learning/render-html-widget.hl
                           widget:x:@.dp/#/*/file

         unwrap:x:+/+/+/+/+/*/*/.sse/*/.base_url
         unwrap:x:+/+/+/+/*/*/.sse/*/.extra
         unwrap:x:+/+/+/*/*/.sse/*/.user-id
         unwrap:x:+/+/*/*/.sse/*/.type
         unwrap:x:+/*/*/.sse/*/.session
         add:x:../*/.invoke/*/while/*/.lambda/*/.exe/*/http.post
            .
               .sse

                  /*
                   * Forward evaluated further up, contains the session ID,
                   * and is also our socket channel for notifying client
                   * about new tokens received from OpenAI.
                   */
                  .session:x:@.arguments/*/session

                  // Needed in case function invocations needs to know the base URL of the server
                  .base_url:x:@.host

                  // Extra information from client.
                  .extra:x:@.arguments/*/extra

                  // Type forward declared further up in file.
                  .type:x:@.arguments/*/type

                  // Type forward declared further up in file.
                  .user-id:x:@.arguments/*/user_id

                  // Verifying OpenAI sent us actual content.
                  if
                     and
                        exists:x:@.arguments/*/message
                        not-null:x:@.arguments/*/message
                        strings.starts-with:x:@.arguments/*/message
                           .:"data:"
                     .lambda

                        // Parsing message sent to us from OpenAI.
                        strings.substring:x:@.arguments/*/message
                           .:int:5
                        strings.trim:x:@strings.substring

                        // Making sure OpenAI sent us something at all, and that it didn't send the "[DONE]" message.
                        if
                           and
                              neq:x:@strings.trim
                                 .:
                              neq:x:@strings.trim
                                 .:[DONE]
                           .lambda

                              .json
                              add:x:@.json
                                 json2lambda:x:@strings.trim

                              switch:x:@.json/*/type

                                 // A token of text, appended to [.result] and streamed to the client.
                                 case:response.output_text.delta

                                    set-value:x:@.result
                                       strings.concat
                                          get-value:x:@.result
                                          get-value:x:@.json/*/delta
                                    unwrap:x:+/*/*
                                    sockets.signal:x:@.session
                                       args
                                          message:x:@.json/*/delta

                                 /*
                                  * A finished output item. Text items already streamed token by token, so
                                  * only function calls matter here - each one is queued for execution once
                                  * the response completes, and the client is told a function is on its way.
                                  */
                                 case:response.output_item.done

                                    if
                                       eq:x:@.json/*/item/*/type
                                          .:function_call
                                       .lambda
                                          add:x:@.calls
                                             .
                                                .
                                                   type:function_call
                                          add:x:@.calls/0/-
                                             get-nodes:x:@.json/*/item/*/call_id
                                             get-nodes:x:@.json/*/item/*/name
                                             get-nodes:x:@.json/*/item/*/arguments
                                          sockets.signal:x:@.session
                                             args
                                                function_waiting:bool:true

                                 /*
                                  * OpenAI is done with this response. Either it holds function calls, which are
                                  * executed now such that the loop can invoke OpenAI again with their outputs,
                                  * or it is the final answer and the client is told we're finished.
                                  */
                                 case:response.completed
                                 case:response.incomplete

                                    set-value:x:@.finish_reason
                                       get-value:x:@.json/*/response/*/status

                                    // Checking if we're counting invocations.
                                    if
                                       neq:x:@.no-invocation
                                          .:int:0
                                       .lambda

                                          /*
                                           * Incrementing invocation count since we've already started counting
                                           * due to function invocations.
                                           */
                                          math.increment:x:@.no-invocation

                                    if
                                       exists:x:@.calls/*
                                       .lambda

                                          /*
                                           * Checking we're allowed to invoke OpenAI another time. If this was the
                                           * last invocation the type allows, the calls are not executed, and the
                                           * conversation ends here.
                                           */
                                          if
                                             lte:x:@.iterations
                                                .:int:1
                                             .lambda

                                                // Too many function invocations
                                                log.error:Too many function invocations
                                                sockets.signal:x:@.session
                                                   args
                                                      function_error:Too many function invocations
                                                sockets.signal:x:@.session
                                                   args
                                                      error:bool:true
                                                      status:int:500
                                                      message:Too many function invocations. Configure your type to handle more invocations or change your prompt.
                                                sockets.signal:x:@.session
                                                   args
                                                      finished:bool:true

                                          else

                                             if
                                                eq:x:@.no-invocation
                                                   .:int:0
                                                .lambda

                                                   // Incrementing our invocation count initially.
                                                   math.increment:x:@.no-invocation

                                             // Executing each function call, in case there are more than one.
                                             for-each:x:@.calls/*

                                                /*
                                                 * The call itself goes back to OpenAI ahead of its output,
                                                 * since OpenAI rejects an output without the call it answers.
                                                 */
                                                add:x:@.function-items
                                                   get-nodes:x:@.dp/#

                                                // Resolving the tool name to its file, which verifies the type declares it.
                                                .file
                                                set-value:x:@.file
                                                   get-value:x:@.functions/*/*/name/={@.dp/#/*/name}/./*/file

                                                /*
                                                 * A widget tool renders a fixed file - the model's arguments are the
                                                 * values for its placeholders, and the file is supplied here.
                                                 */
                                                .invocation-arguments
                                                set-value:x:@.invocation-arguments
                                                   get-value:x:@.dp/#/*/arguments
                                                .widget
                                                set-value:x:@.widget
                                                   get-value:x:@.functions/*/*/name/={@.dp/#/*/name}/./*/widget
                                                if
                                                   not-null:x:@.widget
                                                   .lambda
                                                      .args
                                                         filename
                                                         arguments
                                                      set-value:x:@.args/*/filename
                                                         get-value:x:@.widget
                                                      json2lambda:x:@.dp/#/*/arguments
                                                      add:x:@.args/*/arguments
                                                         get-nodes:x:@json2lambda/*
                                                      set-value:x:@.invocation-arguments
                                                         lambda2json:x:@.args/*

                                                // The output handed back to OpenAI for this call.
                                                .output

                                                // Executing function such that we can catch exceptions and provide meaningful feedback.
                                                try

                                                   if
                                                      null:x:@.file
                                                      .lambda
                                                         throw:That function doesn't exist on type
                                                            public:bool:true
                                                            status:int:400

                                                   // Executing Hyperlambda function file.
                                                   execute:magic.ai.functions.invoke
                                                      file:x:@.file
                                                      arguments:x:@.invocation-arguments
                                                      type:x:@.type
                                                      session:x:@.session
                                                      user-id:x:@.user-id
                                                      extra:x:@.extra
                                                      base_url:x:@.base_url

                                                   // Transforming result to JSON.
                                                   .content

                                                   // Checking if function returned a composite object.
                                                   if
                                                      exists:x:@execute/*/result/*
                                                      .lambda
                                                         set-value:x:@.content
                                                            lambda2json:x:@execute/*/result/*
                                                               format:true
                                                   else
                                                      set-value:x:@.content
                                                         convert:x:@execute/*/result
                                                            type:string

                                                   // Function file succeeded, returning result to caller.
                                                   config.get:"magic:chat:functions:success-message"
                                                      .:"Success!"
                                                   unwrap:x:+/*/*
                                                   sockets.signal:x:@.session
                                                      args
                                                         function_result:x:@config.get
                                                         invocation:x:@.dp/#/*/arguments
                                                         file:x:@.file

                                                   if
                                                      not-null:x:@.content
                                                      .lambda
                                                         set-value:x:@.output
                                                            get-value:x:@.content

                                                         // Storing result of function invocation such that we can store it in ml_requests.
                                                         set-value:x:@.function-result
                                                            strings.concat
                                                               get-value:x:@.function-result
                                                               get-value:x:@.content
                                                               .:"\n"
                                                   else

                                                      // No return value, but OpenAI still needs to know the invocation succeeded.
                                                      set-value:x:@.output
                                                         .:Invocation succeeded, but returned nothing.
                                                      set-value:x:@.function-result
                                                         .:Function returned nothing!

                                                .catch

                                                   // Function file failed.
                                                   log.error:Could not execute AI function
                                                      message:x:@.arguments/*/message
                                                   unwrap:x:+/*/*
                                                   sockets.signal:x:@.session
                                                      args
                                                         function_error:x:@.arguments/*/message
                                                         invocation:x:@.dp/#/*/arguments
                                                         file:x:@.file
                                                   set-value:x:@.output
                                                      strings.concat
                                                         .:"Invocation failed, exception message was: '"
                                                         get-value:x:@.arguments/*/message
                                                         .:"'"

                                                unwrap:x:+/*/*/*
                                                add:x:@.function-items
                                                   .
                                                      .
                                                         type:function_call_output
                                                         call_id:x:@.dp/#/*/call_id
                                                         output:x:@.output

                                    else

                                       // OpenAI is done.
                                       sockets.signal:x:@.session
                                          args
                                             finished:bool:true
                                       set-value:x:@.iterations
                                          .:int:0

                                 // OpenAI failed. The client is told why, and the loop ends.
                                 case:response.failed
                                 case:error

                                    .message
                                    set-value:x:@.message
                                       get-first-value
                                          get-value:x:@.json/*/response/*/error/*/message
                                          get-value:x:@.json/*/message
                                    log.error:OpenAI failed while streaming
                                       message:x:@.message
                                    unwrap:x:+/*/*
                                    sockets.signal:x:@.session
                                       args
                                          error:bool:true
                                          status:int:500
                                          message:x:@.message
                                    set-value:x:@.iterations
                                       .:int:0

         /*
          * Making sure we parametrise invocation to OpenAI such that it streams result,
          * and declares the type's functions as tools.
          */
         add:x:../*/.invoke/*/while/*/.lambda/*/.exe/*/http.post/*/payload
            .
               stream:bool:true
         if
            exists:x:@.tools/*
            .lambda
               add:x:../*/.invoke/*/while/*/.lambda/*/.exe/*/http.post/*/payload
                  .
                     tools
               add:x:../*/.invoke/*/while/*/.lambda/*/.exe/*/http.post/*/payload/*/tools
                  get-nodes:x:@.tools/*

   /*
    * Lambda object actually invoking OpenAI.
    *
    * Notice, if we're streaming the result, this will be invoked one a different thread,
    * otherwise it will be invoked synchronously.
    */
   insert-before:x:./*/.invoke/0
      get-nodes:x:@.arguments
      get-nodes:x:@.session
      get-nodes:x:@.token
      get-nodes:x:@.fixed
      get-nodes:x:@.no-cache
      get-nodes:x:@.functions
   .invoke

      /*
       * As long as this is more than 0, we will continue invoking OpenAI,
       * since OpenAI might return one or more function invocations that requires further
       * analysis in a loop.
       *
       * If OpenAI does not return function invocations, we set this to 0, which stops
       * our loop invoking OpenAI
       */
      .iterations
      set-value:x:@.iterations
         convert:x:@.arguments/*/max_function_invocations
            type:int

      /*
       * This is the buffer for what iteration we are currently on, used to modify the
       * history request to providing numbering.
       */
      .no-invocation:int:0

      // Contains result and finish reason from OpenAI.
      .result:
      .finish_reason

      // Contains result of function invocation.
      .function-result

      // Invoking OpenAI as longs as we have function invocations and have not invoked it more than a maximum of configured times.
      while
         mt:x:@.iterations
            .:int:0
         .lambda

            // Resetting buffers.
            set-value:x:@.result
               .:
            set-value:x:@.finish_reason
               .:

            // Function calls OpenAI returned in this response, and the items going back to it for them.
            .calls
            .function-items

            // Invoking OpenAI now with context being either training data or previous messages.
            add:x:./*/.exe/*/http.post/*/payload/*/input
               get-nodes:x:@.session/*

            /*
             * Reasoning effort defaults to "low". If the prompt contains "think hard" effort is
             * raised to "high", and "think extra hard" raises it to "xhigh".
             */
            strings.to-lower:x:@.arguments/*/prompt
            if
               strings.contains:x:@strings.to-lower
                  .:think hard
               .lambda
                  set-value:x:@.lambda/././*/.exe/*/http.post/*/payload/*/reasoning/*/effort
                     .:high
            else-if
               strings.contains:x:@strings.to-lower
                  .:think extra hard
               .lambda
                  set-value:x:@.lambda/././*/.exe/*/http.post/*/payload/*/reasoning/*/effort
                     .:xhigh

            // Invoking OpenAI's API.
            .exe

               // Making sure we transmit tokens to frontend.
               lambda2json:x:./*/http.post/*/payload/*/input/*
               openai.tokenize:x:-
               sockets.signal:x:@.arguments/*/session
                  args
                     type:input_tokens
                     value:x:@openai.tokenize

               http.post:"https://api.openai.com/v1/responses"
                  convert:bool:true
                  timeout:180
                  headers
                     Authorization:x:@.token
                     Content-Type:application/json
                     Accept:text/event-stream
                     Accept-Encoding:identity
                     Connection:close
                  payload
                     model:x:@.arguments/*/model
                     max_output_tokens:x:@.arguments/*/max_tokens
                     reasoning
                        effort:low
                     input

            // Making sure we apply retry logic in case network flunks on us.
            .retry:int:3
            .wait:int:5000
            while
               mt:x:@.retry
                  .:int:0
               .lambda
                  try
                     .exe2
                     add:x:@.exe2
                        get-nodes:x:@.exe/*
                     eval:x:@.exe2
                     set-value:x:@.retry
                        .:int:0
                     remove-nodes:x:@.exe/*
                     add:x:@.exe
                        get-nodes:x:@.exe2/*
                  .catch

                     // In case this is a transitional error, we wait for one second before we retry.
                     log.error:Something went wrong while invoking OpenAI
                        message:x:@.arguments/*/message
                     math.decrement:x:@.retry
                     sleep:x:@.wait
                     set-value:x:@.wait
                        math.multiply
                           get-value:x:@.wait
                           .:int:2

            // Sanity checking above invocation.
            if
               not
                  and
                     mte:x:@.exe/*/http.post
                        .:int:200
                     lt:x:@.exe/*/http.post
                        .:int:300
               .lambda

                  // Oops, error - Logging error and returning HTTP status code to caller.
                  lambda2hyper:x:@.exe/*/http.post
                  log.error:Something went wrong while invoking OpenAI
                     message:x:@.exe/*/http.post/*/content/*/error/*/message
                     status:x:@.exe/*/http.post
                     error:x:@lambda2hyper

                  // We only throw exception if we're NOT streaming.
                  if
                     or
                        not-exists:x:@.arguments/*/stream
                        eq:x:@.arguments/*/stream
                           .:bool:false
                     .lambda

                        // Not streaming, hence we're on the main thread and can safely throw exceptions.
                        throw:x:@.exe/*/http.post/*/content/*/error/*/message
                           public:bool:true
                           status:x:@.exe/*/http.post

                  else

                     // Signaling client with the error returned from OpenAI.
                     unwrap:x:+/*/*
                     sockets.signal:x:@.arguments/*/session
                        args
                           error:bool:true
                           status:x:@.exe/*/http.post
                           message:x:@.exe/*/http.post/*/content/*/error/*/message

                     // Making sure we stop loop.
                     set-value:x:@.iterations
                        .:int:0

            else

               // Success!
               log.info:Invoking OpenAI was a success

               // Decrementing [.iterations] to avoid invoking OpenAI more than maximum configured amount.
               math.decrement:x:@.iterations

            /*
             * Checking if we're NOT streaming result, at which point we must
             * set above [.result] to response from HTTP invocation.
             */
            if
               or
                  not-exists:x:@.arguments/*/stream
                  eq:x:@.arguments/*/stream
                     .:bool:false
               .lambda

                  /*
                   * Our HTTP POST invocation will return the actual response,
                   * since it's not being streamed using SSE.
                   */
                  set-value:x:@.result
                     get-value:x:@.exe/*/http.post/*/content/*/output/*/*/type/=message/./[0,1]/*/content/0/*/text
                  set-value:x:@.finish_reason
                     get-value:x:@.exe/*/http.post/*/content/*/status

                  // We only iterate if we're streaming response.
                  set-value:x:@.iterations
                     .:int:0

            // Making sure we trim response.
            set-value:x:@.result
               strings.trim:x:@.result

            // Adding current prompt to session, but only if caller provided a session.
            if
               and
                  exists:x:@.arguments/*/session
                  not-null:x:@.arguments/*/session
               .lambda

                  // Caller provided a session.
                  if
                     and
                        not-null:x:@.result
                        neq:x:@.result
                           .:
                     .lambda
                        openai.tokenize:x:@.result
                        sockets.signal:x:@.arguments/*/session
                           args
                              type:output_tokens
                              value:x:@openai.tokenize
                        unwrap:x:+/*/*/*/content
                        add:x:@.session
                           .
                              .
                                 role:assistant
                                 content:x:@.result

                  // Function calls and their outputs go back to OpenAI on the next invocation.
                  add:x:@.session
                     get-nodes:x:@.function-items/*

                  // Removing everything but items that are supposed to be cached.
                  .cache-session
                  add:x:@.cache-session
                     get-nodes:x:@.session/*
                  .tmp
                  set-value:x:@.tmp
                     get-value:x:@.no-cache
                  while
                     mt:x:@.tmp
                        .:int:0
                     .lambda

                        // First iteration of invocation
                        remove-nodes:x:@.cache-session/0
                        math.decrement:x:@.tmp

                  // Transforming session to Hyperlambda such that we can store it in cache.
                  lambda2hyper:x:@.cache-session/*

                  // Caching for "session_timeout" seconds (defaults to 20 minutes).
                  cache.set:x:@.arguments/*/session
                     expiration:x:@.arguments/*/session_timeout
                     value:x:@lambda2hyper

                  // Checking if we should permanently store session.
                  if
                     eq:x:@.arguments/*/permanent
                        .:bool:true
                     .lambda

                        // Avoiding "session injection attacks".
                        if
                           and
                              neq:x:@.arguments/*/user_id
                                 auth.ticket.get
                              not
                                 strings.starts-with:x:@.arguments/*/user_id
                                    .:u_
                           .lambda

                              // Oops, somebody tried to inject data into user's persisted session.
                              log.error:Injection attack attempted

                        else

                           /*
                            * Upsert session into ml_history.
                            */
                           .username
                           set-value:x:@.username
                              get-first-value
                                 get-value:x:@.arguments/*/user_id
                                 auth.ticket.get
                           data.connect:magic
                              data.read
                                 table:ml_history
                                 where
                                    and
                                       session_id.eq:x:@.arguments/*/session
                              if
                                 not-exists:x:@data.read/*
                                 .lambda
                                    http.post:"https://api.openai.com/v1/responses"
                                       timeout:60
                                       convert:bool:true
                                       headers
                                          Authorization:x:@.token
                                          Content-Type:application/json
                                       payload
                                          model:x:@.arguments/*/model
                                          max_output_tokens:int:1000
                                          reasoning
                                             effort:low
                                          input
                                             .
                                                role:system
                                                content:Summarise the following text with 3 to 5 words and no punctuation
                                             .
                                                role:user
                                                content:x:@.arguments/*/prompt
                                    data.create
                                       table:ml_history
                                       values
                                          username:x:@.username
                                          session_id:x:@.arguments/*/session
                                          content:x:@lambda2hyper
                                          name:x:@http.post/*/content/*/output/*/*/type/=message/./[0,1]/*/content/0/*/text
                                    data.execute:delete from ml_history where session_id not in (select session_id from ml_history order by created desc limit 25)
                              else
                                 date.now
                                 data.update
                                    table:ml_history
                                    values
                                       content:x:@lambda2hyper
                                       created:x:@date.now
                                    where
                                       and
                                          username.eq:x:@.username
                                          session_id.eq:x:@.arguments/*/session

            // Checking if type is "supervised" at which point we store request.
            if
               and
                  exists:x:@.arguments/*/supervised
                  not-null:x:@.arguments/*/supervised
                  eq
                     convert:x:@.arguments/*/supervised
                        type:int
                     .:int:1
               .lambda

                  // Opening database connection to store request into ml_requests table.
                  data.connect:[generic|magic]

                     // Creating our prompt field.
                     .prompt
                     if
                        mt:x:@.no-invocation
                           .:int:0
                        .lambda

                           // Adding indexing on history request.
                           set-value:x:@.prompt
                              strings.concat
                                 .:[
                                 get-value:x:@.no-invocation
                                 .:"] - "
                                 get-value:x:@.arguments/*/prompt
                     else

                        // Using prompt as was for history request.
                        set-value:x:@.prompt
                           get-value:x:@.arguments/*/prompt

                     // Storing response to ml_requests to keep history.
                     .tmp-completion
                     if
                        not-null:x:@.function-result
                        .lambda

                           // We have a function result.
                           set-value:x:@.tmp-completion
                              strings.concat
                                 get-value:x:@.result
                                 .:"\r\n"
                                 .:"\r\n"
                                 .:"Result of function invocation:\r\n"
                                 .:"\r\n"
                                 .:"```json"
                                 .:"\r\n"
                                 get-value:x:@.function-result
                                 .:"\r\n"
                                 .:"```"

                           // Resetting [.function-result] back to null.
                           set-value:x:@.function-result

                     else

                        // No function invocation result.
                        set-value:x:@.tmp-completion
                           get-value:x:@.result

                     // Normalising the Responses API status to a finish reason.
                     .db-finish-reason
                     switch:x:@.finish_reason
                        case:cached
                           set-value:x:@.db-finish-reason
                              .:cached
                        case:lead
                           set-value:x:@.db-finish-reason
                              .:lead
                        case:questionnaire
                           set-value:x:@.db-finish-reason
                              .:questionnaire
                        case:completed
                           set-value:x:@.db-finish-reason
                              .:stop
                        case:incomplete
                           set-value:x:@.db-finish-reason
                              .:length
                        default
                           set-value:x:@.db-finish-reason
                              .:stop

                     data.create
                        table:ml_requests
                        values
                           type:x:@.arguments/*/type
                           prompt:x:@.prompt
                           completion:x:@.tmp-completion
                           finish_reason:x:@.db-finish-reason
                           session:x:@.arguments/*/session
                           user_id:x:@.arguments/*/user_id
                           referrer:x:@.arguments/*/referrer

      /*
       * Pruning out all our non-cacheable messages - the fixed messages and
       * this request's context - before we start calculating if we should
       * "dream" or "compress context".
       */
      while
         mt:x:@.no-cache
            .:int:0
         .lambda
            remove-nodes:x:@.session/0
            math.decrement:x:@.no-cache

      /*
       * Checking if we're at 100% of accepted messages, at which point
       * we start "dream consolidating memory" to save token in future invocations.
       */
      if
         mte
            get-count:x:@.session/*
            convert:x:@.arguments/*/max_session_items
               type:int
         .lambda
            add:x:+/*/items
               get-nodes:x:@.session/*
            execute-file:/system/openai/dream-prompt.hl
               session:x:@.arguments/*/session
               items
            if
               exists:x:@execute-file/*
               .lambda

                  // Dreaming to compress memory for next invocation.
                  lambda2hyper:x:@execute-file/*
                  cache.set:x:@.arguments/*/session
                     expiration:x:@.arguments/*/session_timeout
                     value:x:@lambda2hyper

            else

               // Pruning previous cached messages in case session exceeds maximum configured amount.
               convert:x:@.arguments/*/max_session_items
                  type:int
               while
                  mt
                     get-count:x:@.session/*
                     get-value:x:@convert
                  .lambda

                     // A function call and its output leave together - see the token pruning further up.
                     if
                        not-null:x:@.session/0/*/call_id
                        .lambda
                           remove-nodes:x:@.session/*/call_id/={@.session/0/*/call_id}/.
                     else
                        remove-nodes:x:@.session/0
               lambda2hyper:x:@.session/*
               cache.set:x:@.arguments/*/session
                  expiration:x:@.arguments/*/session_timeout
                  value:x:@lambda2hyper

   /*
    * Checking if we're streaming, at which point we invoke above [.invoke]
    * on a different thread.
    */
   if
      get-value:x:@.arguments/*/stream
      .lambda

         // Invoking [.invoke] on a new thread.
         insert-before:x:./*/fork/0
            get-nodes:x:@.invoke
         fork
            eval:x:@.invoke

   else

      // Invoking above [.invoke] on main thread.
      eval:x:@.invoke

   // Checking if we've got references.
   if
      and
         exists:x:@.arguments/*/references
         not-null:x:@.arguments/*/references
         get-value:x:@.arguments/*/references
         exists:x:@.context-buffer/*/snippets/*
      .lambda

         // We've got references, returning these to caller.
         add:x:../*/return
            .
               references
         add:x:../*/return/*/references
            get-nodes:x:@.context-buffer/*/snippets/*

   /*
    * Checking if we're NOT streaming, at which point we return the result
    * of the HTTP invocation to caller.
    */
   if
      or
         eq:x:@.arguments/*/stream
            .:bool:false
         not-exists:x:@.arguments/*/stream
      .lambda

         // Not streaming so result was returned by HTTP invocation.
         unwrap:x:+/*/*
         add:x:../*/return
            .
               result:x:@.invoke/*/.result
               finish_reason:x:@.invoke/*/.finish_reason

   // Returning results to caller.
   get-context:execution-id
   unwrap:x:./*/return/**
   return
      db_time:x:@.context-buffer/*/db_time
      stream:x:@.arguments/*/stream
      execution_id:x:@get-context
