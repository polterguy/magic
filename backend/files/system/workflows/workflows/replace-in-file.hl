
/*
 * Replace text in an existing file
 * 
 * Replaces one exact occurrence of [find] with [replace] inside the existing text file [filename], treating both as ordinary literal text and never as a regular expression or a diff. [find] must occur exactly once in the file - if it occurs zero times, or more than once, nothing is written and the error tells you which, in which case you extend [find] with the lines above and below it until it identifies exactly one place. Omit [replace] to delete the text found. Only files inside the '/modules/' and '/etc/' folders can be edited, and Hyperlambda files are verified before they are saved.
 */
.arguments
   _session:string

   // Mandatory filename of the file to edit, such as for instance '/etc/www/index.html'.
   filename:string

   // Mandatory exact text to find, which must occur exactly once in the file.
   find:string

   // Optional text to replace it with. Omit to delete the text found.
   replace:string

.description:Replaces one exact occurrence of [find] with [replace] inside the existing text file [filename]
.type:public

// Replaces the text, refusing to write anything unless [find] identifies exactly one place in the file.
execute-file:/misc/workflows/workflows/files/replace-in-file.hl
   _session:x:@.arguments/*/_session
   filename:x:@.arguments/*/filename
   find:x:@.arguments/*/find
   replace:x:@.arguments/*/replace

// Returning the result of your last action.
return-nodes:x:@execute-file/*
