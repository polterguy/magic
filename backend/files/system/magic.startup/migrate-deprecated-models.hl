
/*
 * Migrates machine learning types off models the chat slot no longer supports.
 *
 * Only gpt-5.2 and newer are supported, spoken to over the Responses API with reasoning - the
 * list below mirrors the one in magic.ai.endpoint-common.hl. A type still referencing anything
 * else fails on its first prompt, and removing models from the code cannot repair types that
 * already exist, since those live in the database - hence this runs at startup and repoints
 * them at gpt-5.6-luna.
 */
try

   // Connecting to Magic database.
   data.connect:[generic|magic]

      // Repointing every type whose model is not supported.
      data.execute:"update ml_types set model = 'gpt-5.6-luna' where model not in ('gpt-5.2', 'gpt-5.2-pro', 'gpt-5.3-codex', 'gpt-5.4', 'gpt-5.4-pro', 'gpt-5.4-mini', 'gpt-5.4-nano', 'gpt-5.5', 'gpt-5.5-pro', 'gpt-5.6-sol', 'gpt-5.6-terra', 'gpt-5.6-luna')"

      /*
       * Only logging when something was actually changed - a silent rewrite of somebody's
       * configuration is worse than a noisy one, and on every later startup this updates nothing.
       */
      if
         mt:x:@data.execute
            .:int:0
         .lambda
            log.info:Migrated machine learning types off models the chat slot no longer supports
               count:x:@data.execute
               to:gpt-5.6-luna

.catch

   // Doing some basic logging.
   log.info:Something went wrong as we tried to migrate machine learning types off unsupported models
      message:x:@.arguments/*/message
