
/*
 * Migrates machine learning types off models the chat slot no longer supports.
 *
 * Supported models are the entries with [chat] in /system/openai/model-catalogue.hl, spoken to
 * over the Responses API with reasoning. A type still referencing anything else fails on its
 * first prompt, and removing models from the catalogue cannot repair types that already exist,
 * since those live in the database - hence this runs at startup and repoints them at gpt-6-luna.
 */
try

   // Listing the supported models as a quoted SQL list, always ending in an empty string.
   io.file.load:/system/openai/model-catalogue.hl
   hyper2lambda:x:@io.file.load
   .models:""
   for-each:x:@hyper2lambda/*
      if
         exists:x:@.dp/#/*/chat
         .lambda
            set-value:x:@.models
               strings.concat
                  get-value:x:@.models
                  .:"'"
                  get-value:x:@.dp/#/*/id
                  .:"', "
   .sql
   set-value:x:@.sql
      strings.concat
         .:"update ml_types set model = 'gpt-6-luna' where model not in ("
         get-value:x:@.models
         .:"'')"

   // Connecting to Magic database.
   data.connect:[generic|magic]

      // Repointing every type whose model is not supported.
      data.execute:x:@.sql

      /*
       * Only logging when something was actually changed - a silent rewrite of somebody's
       * configuration is worse than a noisy one, and on every later startup this updates nothing.
       */
      if
         mt:x:@data.execute
            .:int:0
         .lambda
            log.info:Migrated machine learning types off models the chat slot no longer supports
               count:x:@data.execute
               to:gpt-6-luna

.catch

   // Doing some basic logging.
   log.info:Something went wrong as we tried to migrate machine learning types off unsupported models
      message:x:@.arguments/*/message
