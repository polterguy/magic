
/*
 * Migrates machine learning types off models OpenAI has retired.
 *
 * OpenAI deprecated 'gpt-5-chat-latest' and 'gpt-5.2-codex', and both now answer 404 - so a type
 * still referencing either fails on its first prompt. Removing the models from the code cannot
 * repair types that already exist, since those live in the database, hence this runs at startup
 * and repoints them at the nearest surviving model.
 *
 * Each retired model is replaced by its closest equivalent rather than by one single fallback -
 * somebody who picked a codex model wanted a codex model.
 */
try

   // Connecting to Magic database.
   data.connect:[generic|magic]

      // Repointing any type still referencing a retired model.
      data.update
         table:ml_types
         values
            model:gpt-5.6-luna
         where
            and
               model.eq:gpt-5-chat-latest

      /*
       * Only logging when something was actually changed - a silent rewrite of somebody's
       * configuration is worse than a noisy one, and on every later startup this updates nothing.
       */
      if
         mt:x:@data.update
            .:int:0
         .lambda
            log.info:Migrated machine learning types off a model OpenAI has deprecated
               count:x:@data.update
               from:gpt-5-chat-latest
               to:gpt-5.6-luna

      // Same again for the retired codex model.
      data.update
         table:ml_types
         values
            model:gpt-5.3-codex
         where
            and
               model.eq:gpt-5.2-codex
      if
         mt:x:@data.update
            .:int:0
         .lambda
            log.info:Migrated machine learning types off a model OpenAI has deprecated
               count:x:@data.update
               from:gpt-5.2-codex
               to:gpt-5.3-codex

.catch

   // Doing some basic logging.
   log.info:Something went wrong as we tried to migrate deprecated machine learning models
      message:x:@.arguments/*/message
