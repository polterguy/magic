
// Returns Cryptographically Secure random text (gibberish) to caller according to arguments specified.
.arguments
   min:long
   max:long

// Sanity checking invocation
validators.integer:x:@.arguments/*/min
   min:1
   max:500
validators.integer:x:@.arguments/*/max
   min:1
   max:500

// Generating gibberish text.
add:x:./*/crypto.random
   get-nodes:x:@.arguments/*
crypto.random

// Generating gibberish text.
unwrap:x:+/*
return
   result:x:@crypto.random
