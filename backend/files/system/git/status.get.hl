/*
 * Returns the status of a Git repository, as structured porcelain
 * status lines including branch information.
 */
.arguments

   // Mandatory folder to where Git repo is locally on disk.
   path:string

// Ensuring user is root.
auth.ticket.verify:root

// Sanity checking invocation.
validators.mandatory:x:@.arguments/*/path

// Sanity checking invocation.
if
   and
      not
         strings.starts-with:x:@.arguments/*/path
            .:/modules/
      not
         strings.starts-with:x:@.arguments/*/path
            .:/etc/
   .lambda
      throw:"Git repos must be in folders inside of either '/etc/' or '/modules/'"

// Invoking slot.
git.status:x:@.arguments/*/path
   porcelain:true
   branch:true
   structured:true

// Returning status lines to caller.
return-nodes:x:@git.status/*
