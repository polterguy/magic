
/*
 * Lists all indexes in some PostgreSQL table.
 * 
 * Arguments
 * 
 * - [connection-string] - What connection string to use
 * - [database] - What database you want to check
 * - [table] - What table you want to check
 */
slots.create:magic.db.pgsql.indexes

   // Sanity checking invocation.
   validators.mandatory:x:@.arguments/*/database
   validators.mandatory:x:@.arguments/*/table

   // Splitting [table] into schema and table, defaulting schema to 'public' unless given as 'schema.table'.
   .schema:public
   strings.split:x:@.arguments/*/table
      .:.
   if
      exists:x:@strings.split/1
      .lambda
         set-value:x:@.schema
            get-value:x:@strings.split/0

   // Opens up our connection
   .connection:[postgres]
   if
      and
         not
            eq
               get-value:x:@.arguments/*/connection-string
               .
         not
            eq
               get-value:x:@.arguments/*/connection-string
               .:
      .lambda
         set-value:x:@.connection
            strings.concat
               .:[
               get-value:x:@.arguments/*/connection-string
               .:|
               get-value:x:@.arguments/*/database
               .:]
   else
      set-value:x:@.connection
         strings.concat
            .:[generic|
            get-value:x:@.arguments/*/database
            .:]
   pgsql.connect:x:@.connection

      // Runs our query, excluding primary key and unique constraint indexes.
      pgsql.select:@"
select
    i.relname as index_name,
    a.attname as column_name
from pg_class t
    join pg_namespace n on n.oid = t.relnamespace
    join pg_index ix on t.oid = ix.indrelid
    join pg_class i on i.oid = ix.indexrelid
    join pg_attribute a on a.attrelid = t.oid and a.attnum = ANY(ix.indkey)
where
    t.relkind in ('r', 'p')
    and not ix.indisprimary
    and not ix.indisunique
    and t.relname = @table
    and n.nspname = @schema"
         @table:x:@strings.split/0/-
         @schema:x:@.schema

      /*
       * Creating our return value, by projecting it into
       * a generic form, that does not rely upon MySQL's syntactic
       * details.
       */
      for-each:x:@pgsql.select/*
         unwrap:x:+/*/*/*
         add:x:@pgsql.connect/*/return-nodes
            .
               .
                  name:x:@.dp/#/*/index_name
                  columns
         unwrap:x:+/*/*
         add:x:@pgsql.connect/*/return-nodes/0/-/*/columns
            .
               .:x:@.dp/#/*/column_name
      return-nodes
