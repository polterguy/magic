
/*
 * Authenticates a user returning a JWT token if successful.
 *
 * Notice, if Magic is not already setup, implying the auth secret is less than 50
 * characters in length, then the default username and password is root/root and is
 * hard coded.
 *
 * The JWT token returned will contain the roles the user belongs to. This endpoint
 * will also return extra information associated with the user.
 */
.arguments
   username:string
   password:string

// Sanity checking invocation.
validators.mandatory:x:@.arguments/*/username
validators.mandatory:x:@.arguments/*/password

/*
 * Throttling login attempts, protecting against brute force attacks. The throttles are
 * declared once at startup by /system/magic.startup/throttles.hl, and shared by every
 * unauthenticated auth endpoint - hammering one endpoint spends the budget of them all.
 */
execution.throttle:auth.ip
execution.throttle:auth.global

/*
 * Checking if JWT secret has been changed, and if not, simply checking if username/password is
 * root/root, and if so returning a valid token allowing the user to setup his or her cloudlet.
 *
 * This is necessary to allow for configuring a new cloudlet where the user haven't selected a root
 * password yet.
 *
 * Notice, root/root only works as long as the JWT secret is missing or shorter than 50 characters,
 * and the tokens it creates are signed with a random key that only exists in memory. If you don't
 * want your backend to ever be in this state, for instance when you create your own Docker image or
 * deployment, you can avoid it entirely by executing a Hyperlambda startup file in a magic.startup
 * folder, or an SQL "migration" file, that runs before your backend accepts requests, and does the
 * same as /system/config/setup does; Insert your root user into the magic database, with a password
 * of your choosing, and replace the JWT secret in appsettings.json with a value created by the
 * built-in CSRNG, [crypto.random] with at least 100 characters, saved using [config.save].
 *
 * Notice, an SQL file can only insert the root user, since the JWT secret lives in appsettings.json
 * and not in the database, so the secret must still be changed by Hyperlambda or by your image.
 * Once the secret is 50 characters or longer, this check is skipped and root/root never works.
 */
config.get:"magic:auth:secret"
if
   or
      null:x:@config.get
      lt
         strings.length:x:@config.get
         .:int:50
   .lambda

      // System has not been setup.
      if
         and
            eq
               get-value:x:@.arguments/*/username
               .:root
            eq
               get-value:x:@.arguments/*/password
               .:root
         .lambda

            // Success!
            auth.ticket.create
               username:root
               roles
                  .:root
            yield
               ticket:x:@auth.ticket.create

      // Throwing exception
      throw:Not authenticated
         public:bool:true
         status:int:401

/*
 * Invokes [magic.auth.authenticate] that does the heavy lifting, and creates our JWT token,
 * making sure we return that token to caller.
 */
execute:magic.auth.authenticate
   username:x:@.arguments/*/username
   password:x:@.arguments/*/password

// Buffer for extra information.
.extra
data.connect:magic
   data.read
      table:users_extra
      where
         and
            user.eq:x:@.arguments/*/username
            or
               type.eq:name
               type.eq:email
   for-each:x:@data.read/*
      set-name:x:./*/add/*/*
         get-value:x:@.dp/#/*/type
      set-value:x:./*/add/*/*
         get-value:x:@.dp/#/*/value
      add:x:@.extra
         .
            .

// Returns the authentication JWT ticket created above to caller.
yield
   ticket:x:@execute/*/ticket
   extra:x:@.extra/*
