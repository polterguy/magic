/*
 * Returns true if this backend can send password reset links, which requires
 * SMTP to have been configured.
 *
 * Public because the login screen has to know whether to offer the option
 * before anyone has authenticated, and offering a link that can never be
 * delivered is worse than not offering it at all.
 */
.arguments
.description:Returns true if the backend has SMTP configured and can send password reset links
.type:public

// An SMTP server with no sender address cannot send anything either.
if
   or
      eq
         config.get:"magic:smtp:host"
         .
      eq
         config.get:"magic:smtp:from:address"
         .
   .lambda

      // SMTP has not been configured.
      return
         result:bool:false

// SMTP is configured.
return
   result:bool:true
