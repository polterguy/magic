/*
 * Returns true if this backend can send password reset links, which requires
 * SMTP, "magic:backend:url" and "magic:frontend:urls" to have been configured.
 *
 * Public because the login screen has to know whether to offer the option
 * before anyone has authenticated, and offering a link that can never be
 * delivered is worse than not offering it at all.
 */
.arguments
.description:Returns true if the backend has SMTP, its backend URL and its frontend URLs configured and can send password reset links
.type:public

// An SMTP server with no sender address cannot send anything either.
if
   or
      eq
         config.get:"magic:smtp:host"
         .
      eq
         config.get:"magic:smtp:from:address"
         .
      eq
         config.get:"magic:backend:url"
         .
      eq
         config.get:"magic:frontend:urls"
         .
   .lambda

      // SMTP, the backend URL or the frontend URLs have not been configured.
      return
         result:bool:false

// Everything needed is configured.
return
   result:bool:true
