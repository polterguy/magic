/*
 * Emails a magnetic link to the specified user, letting them sign in without
 * their password and change it once they arrive.
 *
 * The [user] argument is either a username or an email address. When it is a
 * username the email is taken from the user's "email" extra field, so a user
 * without an email on file behaves exactly like a user that does not exist.
 *
 * Notice, this endpoint deliberately returns the same result whether or not
 * the user exists, whether or not they have an email address, and whether or
 * not SMTP is configured. Anything else turns a public endpoint into an
 * oracle for discovering which usernames and email addresses are real.
 */
.arguments
   user:string

// Sanity checking invocation.
validators.mandatory:x:@.arguments/*/user
validators.string:x:@.arguments/*/user
   min:1
   max:256

/*
 * Throttling reset requests - this endpoint sends email, so without a budget it is a
 * spam cannon. Declared at startup by /system/magic.startup/throttles.hl, and shared
 * by every unauthenticated auth endpoint.
 */
execution.throttle:auth.ip
execution.throttle:auth.global

/*
 * The response every caller gets, regardless of what happened below.
 */
.result:If that account exists, a sign in link is on its way

// No point continuing if the backend cannot send email.
if
   or
      eq
         config.get:"magic:smtp:host"
         .
      eq
         config.get:"magic:smtp:from:address"
         .
   .lambda

      // SMTP is not configured, so no link can be sent.
      log.info:Password reset requested but SMTP is not configured
      unwrap:x:+/*
      return
         result:x:@.result

/*
 * The link is built from "magic:backend:url" and nothing else - the Host header is attacker
 * controlled on this unauthenticated endpoint, so anyone could ask for a link for somebody
 * else's account with a Host of their own, and the emailed link would then carry that
 * account's session token to the attacker's domain. Without the setting no link is sent.
 */
.backend
set-value:x:@.backend
   config.get:"magic:backend:url"
if
   null:x:@.backend
   .lambda

      // Not configured, so no link can be sent safely.
      log.error:"Password reset requested but [magic:backend:url] is not configured, no link was sent"
      unwrap:x:+/*
      return
         result:x:@.result

// The frontend URLs must be configured too, or no link is sent, exactly as can-reset-password.
.frontend
set-value:x:@.frontend
   config.get:"magic:frontend:urls"
if
   null:x:@.frontend
   .lambda

      // Not configured, so no link can be sent safely.
      log.error:"Password reset requested but [magic:frontend:urls] is not configured, no link was sent"
      unwrap:x:+/*
      return
         result:x:@.result

/*
 * Resolving the username and email address of the user asking for a link.
 *
 * The argument is matched against usernames first, and against the "email"
 * extra field second, so either identifies the same account.
 */
.username
.email
data.connect:[generic|magic]

   // Checking if the argument is a username.
   data.read
      table:users
      columns
         username
      where
         and
            username.eq:x:@.arguments/*/user
   if
      exists:x:@data.read/*/*
      .lambda
         set-value:x:@.username
            get-value:x:@data.read/*/*/username

   else

      // Not a username, so checking if it is an email address.
      data.read
         table:users_extra
         columns
            user
         where
            and
               type.eq:email
               value.eq:x:@.arguments/*/user
      if
         exists:x:@data.read/*/*
         .lambda
            set-value:x:@.username
               get-value:x:@data.read/*/*/user

   // Looking up the email address to send to, if we resolved a user at all.
   if
      not-null:x:@.username
      .lambda
         data.read
            table:users_extra
            columns
               value
            where
               and
                  user.eq:x:@.username
                  type.eq:email
         if
            exists:x:@data.read/*/*
            .lambda
               set-value:x:@.email
                  get-value:x:@data.read/*/*/value

// Bailing out silently if we have nobody to send to.
if
   or
      null:x:@.username
      null:x:@.email
   .lambda

      // Unknown user, or a user without an email address on file.
      log.info:Password reset requested for an account that cannot be emailed
      unwrap:x:+/*
      return
         result:x:@.result

/*
 * Reading the roles the user actually has - the emailed token is the session
 * they sign in with, so it has to carry the same roles their password would
 * have given them.
 */
.roles
data.connect:[generic|magic]
   data.read
      table:users_roles
      columns
         role
      where
         and
            user.eq:x:@.username
   for-each:x:@data.read/*/*/role
      unwrap:x:+/*/*
      add:x:@.roles
         .
            .:x:@.dp/#

// Short lived, because it travels by email and sits in an inbox.
math.add
   date.now
   time
      minutes:20
add:x:./*/auth.ticket.create/*/roles
   get-nodes:x:@.roles/*
auth.ticket.create
   username:x:@.username
   expires:x:@math.add
   roles

/*
 * Building the link back to the dashboard.
 *
 * The Origin header is deliberately ignored - on this unauthenticated endpoint it is
 * entirely attacker controlled, and trusting it would let anyone redirect this email's
 * session token to a domain of their own choosing. The dashboard is the first origin in
 * the comma separated "magic:frontend:urls" setting, the same setting CORS already uses
 * to decide which frontends this backend trusts.
 */
.dashboard
strings.split:x:@.frontend
   .:,
set-value:x:@.dashboard
   strings.trim:x:@strings.split/0

.link
set-value:x:@.link
   strings.concat
      .:x:@.dashboard
      .:"/authentication/magic-link?backend="
      strings.url-encode:x:@.backend
      .:"&token="
      strings.url-encode:x:@auth.ticket.create

// Plain text body, so no mail client has to render anything.
.body
set-value:x:@.body
   strings.concat
      .:"Hi,\n\nUse the link below to sign in. It expires in 20 minutes and works once.\n\n"
      .:x:@.link
      .:"\n\nIf you did not ask for this, you can ignore this email - nothing has changed.\n"

// Sending the link.
unwrap:x:+/**/content
mail.smtp.send
   message
      to
         .
            name:x:@.username
            email:x:@.email
      subject:Sign in link
      entity:text/plain
         content:x:@.body

// Logging that a link was sent, without recording the address.
log.info:Password reset link sent

// Returning the same result as every other path above.
unwrap:x:+/*
return
   result:x:@.result
