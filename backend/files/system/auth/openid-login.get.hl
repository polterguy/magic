
/*
 * Verifies the specified OpenID Connect JWT Token and returns a valid application JWT token accordingly.
 *
 * This will verify the token towards the issuers of all OpenID providers registered in the system,
 * refusing to fetch meta data from issuers we do not recognise, download any public keys to verify
 * the signature, and return the email, name and issuer from the token.
 *
 * If it succeeds it will return a new application specific JWT token.
 * If it fails it will throw an exception.
 *
 * Notice, the endpoint will only return valid JWT tokens for OIDC providers that are
 * registered in the system with existing configurations. See the "openid-providers.get.hl" file for
 * details about how to register a new OIDC provider in the app.
 */
.arguments
   token:string

/*
 * Throttling token verification attempts - this endpoint fetches issuer meta data and
 * verifies signatures, making it the most expensive unauthenticated endpoint we have.
 * Declared at startup by /system/magic.startup/throttles.hl, and shared by every
 * unauthenticated auth endpoint.
 */
execution.throttle:auth.ip
execution.throttle:auth.global

/*
 * Loading our registered OpenID providers, such that we can supply the verify slot below
 * with the complete list of trusted issuers, preventing it from fetching meta data from
 * issuers we have not registered ourselves.
 */
execute-file:/system/auth/openid-providers.get.hl
   createNonce:bool:false

/*
 * Verifying token.
 *
 * Notice, this will throw an exception if token is not valid, or its issuer is not
 * among our registered providers supplied to it above.
 */
auth.token.verify
   token:x:@.arguments/*/token
   issuers:x:@execute-file/*/*/issuer

/*
 * Verifying nonce from token to avoid replay attacks.
 */
cache.get:x:@auth.token.verify/*/nonce
if
   neq:x:@cache.get
      get-value:x:@auth.token.verify/*/issuer
   .lambda

      // Oops ...!!
      throw:Nonce is not valid!
         status:int:400
         public:bool:true

// Removing nonce from cache to avoid replay attacks.
cache.set:x:@auth.token.verify/*/nonce

// Verifying issuer is active, capturing the provider's name as we find it.
.active:bool:false
.provider
for-each:x:@execute-file/*
   if
      eq:x:@.dp/#/*/issuer
         get-value:x:@auth.token.verify/*/issuer
      .lambda
         set-value:x:@.active
            .:bool:true
         set-value:x:@.provider
            strings.to-lower:x:@.dp/#/*/name
if
   eq:x:@.active
      .:bool:false
   .lambda

      // Oops ...!
      throw:Not a recognized OpenID provider
         status:400
         public:bool:true

/*
 * External OpenID provider has been verified — logging the user in, creating
 * them on first login. The user-login half lives in a shared file, since the
 * authorization-code flow (openid-exchange.post.hl) ends the exact same way.
 */
unwrap:x:+/*
execute-file:/system/auth/utils/oidc-login-user.hl
   provider:x:@.provider
   email:x:@auth.token.verify/*/email
   name:x:@auth.token.verify/*/name
return-nodes:x:@execute-file/*
