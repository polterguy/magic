
/*
 * Search endpoint, generated by the Search endpoint generator.
 *
 * {description}
 */
.arguments

   // The text to search for, in natural language or as keywords such as names and identifiers.
   query:string

/*
 * Settings - injected by the generator. The [type] is the machine learning type that is searched.
 * [retrieval] is bm25, mixed or embeddings, and left out to use the type's own. [threshold],
 * [uri] and [meta] are left out unless they were set. [limit] is how many matches are returned,
 * and [result] is references, giving only prompt and uri, or rows, also giving completion and
 * meta. [throttle-limit] invocations per [throttle-window] seconds per IP are allowed, root
 * excepted, and none when it is 0. [cache-control] is sent to the caller when it is set.
 */
.policy
   type
   retrieval
   threshold
   limit:int:5
   uri
   meta
   result:references
   throttle-prefix:search
   throttle-limit:int:0
   throttle-window:int:60
   cache-control

// Sanity checking invocation.
validators.mandatory:x:@.arguments/*/query
validators.string:x:@.arguments/*/query
   min:int:1
   max:int:500

// Rate limiting, since every uncached query searching by meaning costs an embedding.
if
   and
      mt:x:@.policy/*/throttle-limit
         .:int:0
      not
         auth.ticket.in-role:root
   .lambda
      execution.throttle.create:x:@.policy/*/throttle-prefix
         limit:x:@.policy/*/throttle-limit
         window:x:@.policy/*/throttle-window
         per:ip
      execution.throttle:x:@.policy/*/throttle-prefix

// Searching, which is shared with every other way of searching a type.
execute-file:/system/openai/search-snippets.hl
   type:x:@.policy/*/type
   query:x:@.arguments/*/query
   retrieval:x:@.policy/*/retrieval
   threshold:x:@.policy/*/threshold
   limit:x:@.policy/*/limit
   uri:x:@.policy/*/uri
   meta:x:@.policy/*/meta

// Letting the caller cache the answer, when that was asked for.
if
   not-null:x:@.policy/*/cache-control
   .lambda
      response.headers.set
         Cache-Control:x:@.policy/*/cache-control

/*
 * Returning the matches, best first, with only what the endpoint was set to give out - the
 * internal id never leaves.
 */
.result
for-each:x:@execute-file/*
   .row
      .
         prompt
         uri
   set-value:x:@.row/0/*/prompt
      get-value:x:@.dp/#/*/prompt
   set-value:x:@.row/0/*/uri
      get-value:x:@.dp/#/*/uri
   if
      eq:x:@.policy/*/result
         .:rows
      .lambda
         add:x:@.row/0
            .
               completion
               meta
         set-value:x:@.row/0/*/completion
            get-value:x:@.dp/#/*/completion
         set-value:x:@.row/0/*/meta
            get-value:x:@.dp/#/*/meta
   add:x:@.result
      get-nodes:x:@.row/*
return-nodes:x:@.result/*
