
/*
 * Sandboxed Hyperlambda endpoint, generated by the Sandbox API generator.
 *
 * {input}{roles}{execute-help}
 *
 * The code is checked - every referenced function must exist on this server - then
 * executed inside a whitelisted sandbox whose vocabulary and rate limit are chosen
 * from the caller's roles. Always returns the code together with a [state] describing
 * what happened, and a [reason] whenever the runtime refused the code or it failed.
 *
 * To discover the exact capability surface available to you, call with [describe] set
 * to true instead of [hyperlambda]/[instruction] - it returns your visible vocabulary,
 * and the rate limit and timeout that apply to you, without executing anything or
 * counting against the rate limit.
 *
 * States: described (a [describe] call), executed, rejected (a function or a pinned
 * argument was not allowed), unknown-slot (a referenced function does not exist),
 * error (the code threw), timeout (execution exceeded the configured limit),
 * generator-failed (no code came back from the Hyperlambda Generator).
 */
.arguments

   // A plain-language description of what you want done, turned into Hyperlambda for you.
   instruction:string

   // Hyperlambda to execute as-is inside the sandbox.
   hyperlambda:string

   // When true, returns your visible vocabulary instead of executing [instruction]/[hyperlambda].
   describe:bool

/*
 * Policy - injected by the generator. [rules] are matched top down: a rule matches
 * when its [role] is '*' or the caller belongs to it. The vocabulary is the union of
 * every matching rule's [slots]. The rate limit and the timeout are each taken from
 * the first matching rule that declares one, resolved independently, so a rule can
 * override one, both, or neither. Rules are ordered most-access-first, and the '*'
 * base rule sits last as the fallback for both.
 */
.policy
   override-root:bool:false
   return-code:bool:false
   generator-url:"https://ainiro.io/magic/modules/hyperlambda-generator/chat"
   throttle-prefix:sandbox
   rules

// Result fields.
.code
.state
.reason
.result
.execute:bool:false

// Resolving the caller's identity once, for the role checks below.
auth.ticket.get

// Whether the caller is root. Root is never rate limited, whatever the policy says.
.is-root:bool:false
if
   auth.ticket.in-role:root
   .lambda
      set-value:x:@.is-root
         .:bool:true

/*
 * Whether the caller bypasses the sandbox entirely, running the code with the
 * server's full vocabulary and no whitelist. Only when the policy enables it AND
 * the caller is root.
 */
.bypass:bool:false
if
   and
      get-value:x:@.policy/*/override-root
      get-value:x:@.is-root
   .lambda
      set-value:x:@.bypass
         .:bool:true

/*
 * Rate limit and timeout for sandboxed (non-root) callers - root has neither. Both are
 * resolved independently by walking the rules top down and taking the first matching rule
 * that declares that dimension, so an earlier rule can override one, both, or neither,
 * with the '*' base rule as the fallback. Resolved ahead of [describe] so that it can tell
 * the caller what it is subject to, and applied only once there is code to run.
 */
.tname
.tlimit:int:0
.twindow:int:0
.ttimeout
if
   not
      get-value:x:@.is-root
   .lambda

      // Rate limit - first matching rule that declares a [limit].
      for-each:x:@.policy/*/rules/*
         if
            and
               null:x:@.tname
               not-null:x:@.dp/#/*/limit
               or
                  eq:x:@.dp/#/*/role
                     .:*
                  auth.ticket.in-role:x:@.dp/#/*/role
            .lambda
               set-value:x:@.tname
                  strings.concat
                     get-value:x:@.policy/*/throttle-prefix
                     .:-
                     get-value:x:@.dp/#/*/role
               set-value:x:@.tlimit
                  get-value:x:@.dp/#/*/limit
               set-value:x:@.twindow
                  get-value:x:@.dp/#/*/window

      // Timeout - first matching rule that declares a [timeout].
      for-each:x:@.policy/*/rules/*
         if
            and
               null:x:@.ttimeout
               not-null:x:@.dp/#/*/timeout
               or
                  eq:x:@.dp/#/*/role
                     .:*
                  auth.ticket.in-role:x:@.dp/#/*/role
            .lambda
               set-value:x:@.ttimeout
                  get-value:x:@.dp/#/*/timeout

/*
 * A caller asking to [describe] the sandbox gets back its own visible vocabulary, and
 * the rate limit and timeout it is subject to, instead of executing anything. This runs
 * before [instruction]/[hyperlambda] are required, and before the rate limit is applied,
 * so discovering what is allowed here never costs the caller's execution budget.
 *
 * The vocabulary is a list with one object per slot, carrying its [name] and its pinned
 * [value] (null when unpinned). It cannot be a map keyed by slot name, since the same
 * slot can be whitelisted more than once with different pinned values.
 */
if
   get-value:x:@.arguments/*/describe
   .lambda

      .response
         state:described
         vocabulary

      /*
       * A bypassing caller (root, when the policy lets root skip the sandbox) runs with
       * the server's full vocabulary, so that is what it is told - never just the base.
       */
      if
         get-value:x:@.bypass
         .lambda
            vocabulary
            for-each:x:@vocabulary/*
               .row
                  .
                     name
                     value
               set-value:x:@.row/0/*/name
                  get-value:x:@.dp/#
               add:x:@.response/*/vocabulary
                  get-nodes:x:@.row/*
            add:x:@.response
               .
                  root-bypass:bool:true
      else

         // Everybody else gets the union of every matching rule's slots.
         .vocabulary
         for-each:x:@.policy/*/rules/*
            if
               or
                  eq:x:@.dp/#/*/role
                     .:*
                  auth.ticket.in-role:x:@.dp/#/*/role
               .lambda
                  add:x:@.vocabulary
                     get-nodes:x:@.dp/#/*/slots/*
         for-each:x:@.vocabulary/*
            .row
               .
                  name
                  value
            set-value:x:@.row/0/*/name
               get-name:x:@.dp/#
            set-value:x:@.row/0/*/value
               get-value:x:@.dp/#
            add:x:@.response/*/vocabulary
               get-nodes:x:@.row/*

      /*
       * What the caller is subject to: invocations per [window] seconds, per IP, and the
       * timeout in milliseconds. Either is left out when it does not apply, as for root.
       */
      if
         not-null:x:@.tname
         .lambda
            add:x:@.response
               .
                  limit
                  window
            set-value:x:@.response/*/limit
               get-value:x:@.tlimit
            set-value:x:@.response/*/window
               get-value:x:@.twindow
      if
         not-null:x:@.ttimeout
         .lambda
            add:x:@.response
               .
                  timeout
            set-value:x:@.response/*/timeout
               get-value:x:@.ttimeout
      return-nodes:x:@.response/*

/*
 * Applying the rate limit resolved above to sandboxed (non-root) callers. The throttle
 * is keyed by the caller's IP; declaring an unchanged throttle keeps its counters, so
 * the declaration can live in the endpoint itself.
 */
if
   not-null:x:@.tname
   .lambda
      execution.throttle.create:x:@.tname
         limit:x:@.tlimit
         window:x:@.twindow
         per:ip
      execution.throttle:x:@.tname

/*
 * Resolving the code to run. A non-empty [instruction] is natural language and is
 * sent to the Hyperlambda Generator; otherwise the raw [hyperlambda] is used.
 */
if
   and
      not-null:x:@.arguments/*/instruction
      neq:x:@.arguments/*/instruction
         .:
   .lambda

      validators.string:x:@.arguments/*/instruction
         min:int:3
         max:int:500
      http.post:x:@.policy/*/generator-url
         convert:bool:true
         timeout:int:60
         payload
            prompt:x:@.arguments/*/instruction
      if
         or
            lt:x:@http.post
               .:int:200
            mte:x:@http.post
               .:int:300
            null:x:@http.post/*/content/*/result
         .lambda
            return
               state:generator-failed
               code
               reason:The Hyperlambda Generator did not return any code.
               result
      set-value:x:@.code
         get-value:x:@http.post/*/content/*/result
else-if
   and
      not-null:x:@.arguments/*/hyperlambda
      neq:x:@.arguments/*/hyperlambda
         .:
   .lambda
      set-value:x:@.code
         get-value:x:@.arguments/*/hyperlambda
else
   throw:Provide either an instruction or Hyperlambda to execute
      status:int:400
      public:bool:true

/*
 * Static sanity check before running anything: every referenced function must exist
 * on this server, otherwise a hallucinated name would be treated as inert data.
 */
hyperlambda.verify-slots:x:@.code
if
   not
      get-value:x:@hyperlambda.verify-slots
   .lambda
      set-value:x:@.state
         .:unknown-slot
      set-value:x:@.reason
         strings.concat
            .:"The code references functions that do not exist on this server: "
            strings.join:x:@hyperlambda.verify-slots/*
               .:", "
else
   set-value:x:@.execute
      .:bool:true

// Bypass callers (root, when the policy allows it) run with full trust, no sandbox.
if
   and
      eq:x:@.execute
         .:bool:true
      eq:x:@.bypass
         .:bool:true
   .lambda

      // No timeout - root is fully trusted with the server.
      try
         hyper2lambda:x:@.code
         invoke:x:@hyper2lambda
         set-value:x:@.state
            .:executed
         if
            not-null:x:@invoke
            .lambda
               set-value:x:@.result
                  get-value:x:@invoke
         else
            add:x:@.result
               get-nodes:x:@invoke/*
      .catch
         if
            strings.contains:x:@.arguments/*/message
               .:cancel
            .lambda
               set-value:x:@.state
                  .:timeout
         else
            set-value:x:@.state
               .:error
         set-value:x:@.reason
            get-value:x:@.arguments/*/message

// Sandboxed callers run inside a whitelist whose vocabulary is chosen from their roles.
else-if
   eq:x:@.execute
      .:bool:true
   .lambda

      try

         // Timeout resolved above; null for root, which is fully trusted with the server.
         if
            not-null:x:@.ttimeout
            .lambda
               execution.timeout:x:@.ttimeout

         // Assembling the vocabulary as the union of every matching rule's slots.
         .vocabulary
         for-each:x:@.policy/*/rules/*
            if
               or
                  eq:x:@.dp/#/*/role
                     .:*
                  auth.ticket.in-role:x:@.dp/#/*/role
               .lambda
                  add:x:@.vocabulary
                     get-nodes:x:@.dp/#/*/slots/*

         // Parsing the code and populating the whitelist's body and vocabulary.
         hyper2lambda:x:@.code
         add:x:./*/whitelist/*/.lambda
            get-nodes:x:@hyper2lambda/*
         add:x:./*/whitelist/*/vocabulary
            get-nodes:x:@.vocabulary/*
         whitelist
            vocabulary
            .lambda
         set-value:x:@.state
            .:executed
         if
            not-null:x:@whitelist
            .lambda
               set-value:x:@.result
                  get-value:x:@whitelist
         else
            add:x:@.result
               get-nodes:x:@whitelist/*
      .catch
         if
            strings.contains:x:@.arguments/*/message
               .:not allowed
            .lambda
               set-value:x:@.state
                  .:rejected
         else-if
            strings.contains:x:@.arguments/*/message
               .:cancel
            .lambda
               set-value:x:@.state
                  .:timeout
         else
            set-value:x:@.state
               .:error
         set-value:x:@.reason
            get-value:x:@.arguments/*/message

/*
 * Returning the verdict and result to the caller, in order: [state], then [code] only
 * when the policy asks for it, then [reason] only when there is one to explain, then
 * [result] last.
 */
.response
   state
set-value:x:@.response/*/state
   get-value:x:@.state

// [code] - only when the policy enables returning it.
if
   get-value:x:@.policy/*/return-code
   .lambda
      add:x:@.response
         .
            code
      set-value:x:@.response/*/code
         get-value:x:@.code

// [reason] - only when there is one; a clean run has nothing to explain.
if
   not-null:x:@.reason
   .lambda
      add:x:@.response
         .
            reason
      set-value:x:@.response/*/reason
         get-value:x:@.reason

// [result] - last, and always present.
add:x:@.response
   .
      result
if
   exists:x:@.result/*
   .lambda
      add:x:@.response/*/result
         get-nodes:x:@.result/*
else
   set-value:x:@.response/*/result
      get-value:x:@.result
return-nodes:x:@.response/*
