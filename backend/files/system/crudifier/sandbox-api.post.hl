
/*
 * Generates a single sandboxed Hyperlambda HTTP endpoint according to the given
 * [.arguments]. The generated endpoint accepts Hyperlambda and/or natural language,
 * resolves it to code, and executes it inside a role based whitelist with a per role
 * rate limit and an execution timeout - see the sandbox.template.hl file it is built
 * from for the full runtime behaviour.
 *
 * [policy] is a JSON string carrying everything that varies between generated
 * endpoints:
 *
 *   {
 *     "timeout": 20000,
 *     "overrideRoot": true,
 *     "maxHyperlambda": 4000,
 *     "generatorUrl": "https://ainiro.io/magic/modules/hyperlambda-generator/chat",
 *     "rules": [
 *       { "role": "*", "limit": 10, "window": 60,
 *         "slots": ["data.read", "data.connect:chinook"],
 *         "description": "Can read from the chinook database" }
 *     ]
 *   }
 *
 * Each slot is a single Hyperlambda line, so a pinned argument is written as
 * "slot:value" (e.g. "data.connect:chinook"). A rule's optional [description] is a
 * short, human-written sentence of what that role can do with its slots - every rule
 * that has one is stitched into the generated endpoint's own file level comment,
 * which is also the tool description a calling AI model sees through MCP.
 *
 * Every endpoint saved is also listed in /etc/www/.well-known/hyperlambda-agent, a well known
 * file pair (hyperlambda-agent.html and its code-behind hyperlambda-agent.hl) that lets an agent
 * discover the sandboxed endpoints on this server without MCP. The folder and the pair are
 * created from the hyperlambda-agent templates next to sandbox.template.hl when missing, never
 * overwritten, and the code-behind gets one entry per endpoint - see the template for the format.
 */
.arguments
   moduleName:string
   endpointName:string
   verb:string
   inputMode:string
   authorization:string
   policy:string
   overwrite:bool
.description:Creates a sandboxed Hyperlambda HTTP endpoint executing caller supplied code inside a role based whitelist
.type:internal

// Sanity checking invocation.
validators.mandatory:x:@.arguments/*/moduleName
validators.mandatory:x:@.arguments/*/endpointName
validators.mandatory:x:@.arguments/*/verb
validators.mandatory:x:@.arguments/*/inputMode
validators.mandatory:x:@.arguments/*/policy
validators.enum:x:@.arguments/*/verb
   .:post
   .:get
   .:put
   .:delete
   .:patch
validators.enum:x:@.arguments/*/inputMode
   .:hl
   .:nl
   .:both

// Ensures user is authorized to access endpoint.
auth.ticket.verify:root

// Logging roughly what we are about to do.
log.info:Generating sandboxed Hyperlambda endpoint
   module:x:@.arguments/*/moduleName
   endpoint:x:@.arguments/*/endpointName
   verb:x:@.arguments/*/verb
   inputMode:x:@.arguments/*/inputMode

// Parsing the policy JSON supplied by the caller.
json2lambda:x:@.arguments/*/policy

// Loading the endpoint template into [.endpoint] so we can inject the policy into it.
io.file.load:/system/crudifier/templates/sandbox.template.hl
.endpoint
add:x:@.endpoint
   hyper2lambda:x:@io.file.load
      comments:bool:true

// Injecting the scalar policy values, keeping the template defaults when omitted.
if
   not-null:x:@json2lambda/*/overrideRoot
   .lambda

      // [json2lambda] already types this as a boolean, so no [convert] is needed.
      set-value:x:@.endpoint/*/.policy/*/override-root
         get-value:x:@json2lambda/*/overrideRoot
if
   not-null:x:@json2lambda/*/returnCode
   .lambda
      set-value:x:@.endpoint/*/.policy/*/return-code
         get-value:x:@json2lambda/*/returnCode
if
   and
      not-null:x:@json2lambda/*/generatorUrl
      neq:x:@json2lambda/*/generatorUrl
         .:
   .lambda
      set-value:x:@.endpoint/*/.policy/*/generator-url
         get-value:x:@json2lambda/*/generatorUrl
if
   and
      not-null:x:@json2lambda/*/maxHyperlambda
      neq:x:@json2lambda/*/maxHyperlambda
         .:
   .lambda
      set-value:x:@.endpoint/*/.policy/*/max-hyperlambda
         get-value:x:@json2lambda/*/maxHyperlambda

// A throttle prefix unique to this endpoint, so its rate limiter is not shared.
set-value:x:@.endpoint/*/.policy/*/throttle-prefix
   strings.concat
      .:sandbox-
      get-value:x:@.arguments/*/moduleName
      .:-
      get-value:x:@.arguments/*/endpointName
      .:-
      get-value:x:@.arguments/*/verb

// Building one policy rule per rule in the supplied JSON.
for-each:x:@json2lambda/*/rules/*

   // Joining this rule's slots, one per line, then parsing them into nodes.
   strings.join:x:@.dp/#/*/slots/*
      .:"\r\n"
   hyper2lambda:x:@strings.join

   /*
    * Building the rule as a single wrapper node under [.rule], then appending that
    * one node to the policy - [add] copies the grandchildren of its source, so the
    * wrapper is what ends up as one [rules] child rather than its fields flattened.
    * [limit]/[window] and [timeout] are added only when the rule declares them, so a
    * rule can override the rate limit, the timeout, both, or neither.
    */
   .rule
      .
         role
         slots
   set-value:x:@.rule/0/*/role
      get-value:x:@.dp/#/*/role
   add:x:@.rule/0/*/slots
      get-nodes:x:@hyper2lambda/*
   if
      and
         not-null:x:@.dp/#/*/description
         neq:x:@.dp/#/*/description
            .:
      .lambda
         add:x:@.rule/0
            .
               description:string
         set-value:x:@.rule/0/*/description
            get-value:x:@.dp/#/*/description
   if
      not-null:x:@.dp/#/*/limit
      .lambda
         add:x:@.rule/0
            .
               limit:int:0
               window:int:0
         set-value:x:@.rule/0/*/limit
            convert:x:@.dp/#/*/limit
               type:int
         set-value:x:@.rule/0/*/window
            convert:x:@.dp/#/*/window
               type:int
   if
      not-null:x:@.dp/#/*/timeout
      .lambda
         add:x:@.rule/0
            .
               timeout:int:0
         set-value:x:@.rule/0/*/timeout
            convert:x:@.dp/#/*/timeout
               type:int
   add:x:@.endpoint/*/.policy/*/rules
      get-nodes:x:@.rule/*

/*
 * Building a "{roles}" block out of every rule's optional [description], one role per
 * line, so the generated endpoint's header - which doubles as its MCP tool description -
 * says what each role can actually do, not just how to call the endpoint. A description
 * can never close the header comment early, so any comment terminator in it is defused.
 */
.role-descriptions
for-each:x:@json2lambda/*/rules/*
   if
      and
         not-null:x:@.dp/#/*/description
         neq:x:@.dp/#/*/description
            .:
      .lambda
         .entry
         set-value:x:@.entry
            strings.concat
               .:"- **"
               get-value:x:@.dp/#/*/role
               .:"**: "
               strings.replace:x:@.dp/#/*/description
                  .:"*/"
                  .:"* /"
         add:x:@.role-descriptions
            get-nodes:x:@.entry

/*
 * Whether any rule grants [execute-file] or [io.file.execute] - unlike most slots, the
 * invocation syntax for executing a pinned file is not obvious from the slot name alone,
 * so the generated header explains it explicitly whenever a rule grants either one.
 */
.has-execute-help:bool:false
for-each:x:@json2lambda/*/rules/*
   for-each:x:@.dp/#/*/slots/*
      if
         or
            strings.starts-with:x:@.dp/#
               .:execute-file
            strings.starts-with:x:@.dp/#
               .:io.file.execute
         .lambda
            set-value:x:@.has-execute-help
               .:bool:true

/*
 * Trimming the input argument the endpoint does not accept, together with the comment
 * documenting it - the comment is the argument's immediately preceding sibling, so it
 * is removed first while the argument still anchors it.
 */
if
   eq:x:@.arguments/*/inputMode
      .:hl
   .lambda
      remove-nodes:x:@.endpoint/*/.arguments/*/instruction/-
      remove-nodes:x:@.endpoint/*/.arguments/*/instruction
if
   eq:x:@.arguments/*/inputMode
      .:nl
   .lambda
      remove-nodes:x:@.endpoint/*/.arguments/*/hyperlambda/-
      remove-nodes:x:@.endpoint/*/.arguments/*/hyperlambda

/*
 * Describing the endpoint according to the input it accepts, by replacing the {input}
 * placeholder in the file level comment (the first node). That comment is the whole
 * description of the endpoint - and, because generated endpoints surface as MCP tools,
 * the tool description the calling model reads - so it must match the arguments the
 * endpoint actually declares.
 */
if
   eq:x:@.arguments/*/inputMode
      .:hl
   .lambda
      set-value:x:@.endpoint/0
         strings.replace:x:@.endpoint/0
            .:"{input}"
            .:"Executes caller-supplied Hyperlambda passed in [hyperlambda]."
else-if
   eq:x:@.arguments/*/inputMode
      .:nl
   .lambda
      set-value:x:@.endpoint/0
         strings.replace:x:@.endpoint/0
            .:"{input}"
            .:"Turns a natural-language [instruction] into Hyperlambda with the Hyperlambda\r\nGenerator, then executes it."
else
   set-value:x:@.endpoint/0
      strings.replace:x:@.endpoint/0
         .:"{input}"
         .:"Accepts caller-supplied Hyperlambda in [hyperlambda], or a natural-language\r\n[instruction] the Hyperlambda Generator turns into code."

// Replacing the "{roles}" placeholder with the sentence built above, or nothing.
if
   exists:x:@.role-descriptions/*
   .lambda
      set-value:x:@.endpoint/0
         strings.replace:x:@.endpoint/0
            .:"{roles}"
            strings.concat
               .:"\r\n\r\nRoles:\r\n\r\n"
               strings.join:x:@.role-descriptions/*
                  .:"\r\n"
else
   set-value:x:@.endpoint/0
      strings.replace:x:@.endpoint/0
         .:"{roles}"
         .:

/*
 * Replacing the "{execute-help}" placeholder with the [execute-file]/[io.file.execute]
 * invocation syntax whenever a rule grants either, or with nothing when none does - the
 * same mechanism as "{roles}" above, keyed off the flag computed while building it.
 */
if
   get-value:x:@.has-execute-help
   .lambda
      set-value:x:@.endpoint/0
         strings.replace:x:@.endpoint/0
            .:"{execute-help}"
            .:"\r\n\r\nIf your vocabulary includes [execute-file] or [io.file.execute], pinned to\r\none or more file paths, you can invoke any of those files directly:\r\n\r\n   execute-file:\"/foo/bar.hl\"\r\n      argument1:\"foo\"\r\n      argument2:int:57\r\n   return-nodes:x:-/*\r\n\r\nThe above returns a list of items. If the file returns a single value instead,\r\nuse:\r\n\r\n   execute-file:\"/foo/bar.hl\"\r\n   return-value:x:-\r\n\r\nMost arguments are optional. Call [describe] to see the exact paths pinned to\r\nyour role, and use [io.file.load] against a given path to read its source and\r\nlearn which arguments it accepts."
else
   set-value:x:@.endpoint/0
      strings.replace:x:@.endpoint/0
         .:"{execute-help}"
         .:

/*
 * If the caller restricted who may invoke the endpoint, inserting the authorization
 * check right after the arguments, so it runs before any policy logic.
 */
if
   and
      not-null:x:@.arguments/*/authorization
      neq:x:@.arguments/*/authorization
         .:
   .lambda
      unwrap:x:+/*/*
      insert-after:x:@.endpoint/*/.arguments
         .
            auth.ticket.verify:x:@.arguments/*/authorization

// Creating the module folder if necessary.
.folder:/modules/
set-value:x:@.folder
   strings.concat
      get-value:x:@.folder
      get-value:x:@.arguments/*/moduleName
      .:/
io.folder.create:x:@.folder

// Figuring out the endpoint's filename.
.filename
set-value:x:@.filename
   strings.concat
      get-value:x:@.folder
      get-value:x:@.arguments/*/endpointName
      .:.
      get-value:x:@.arguments/*/verb
      .:.hl

// Refusing to clobber an existing endpoint unless the caller asked to overwrite it.
if
   and
      not
         get-value:x:@.arguments/*/overwrite
      io.file.exists:x:@.filename
   .lambda
      throw:Endpoint already exists, choose a new name or enable overwrite
         status:400
         public:true

// Serialising and saving the generated endpoint.
lambda2hyper:x:@.endpoint/*
   comments:bool:true
io.file.save:x:@.filename
   get-value:x:@lambda2hyper

/*
 * Advertising the endpoint at /.well-known/hyperlambda-agent, so an agent can find it
 * without MCP. The folder and the file pair are created from their templates when they do
 * not exist yet, and never overwritten once they do.
 */
if
   not
      io.folder.exists:/etc/www/.well-known/
   .lambda
      io.folder.create:/etc/www/.well-known/
.pair
   .:.hl
   .:.html
for-each:x:@.pair/*
   .suffix
   set-value:x:@.suffix
      get-value:x:@.dp/#
   .target
   set-value:x:@.target
      strings.concat
         .:/etc/www/.well-known/hyperlambda-agent
         get-value:x:@.suffix
   if
      not
         io.file.exists:x:@.target
      .lambda
         .source
         set-value:x:@.source
            strings.concat
               .:/system/crudifier/templates/hyperlambda-agent.template
               get-value:x:@.suffix
         io.file.copy:x:@.source
            get-value:x:@.target

/*
 * This endpoint's entry. [description] is the endpoint's file level comment, which is what
 * MCP shows as the tool description, and [auth] is only there when callers are restricted.
 */
.entry
   .
      path
      verb
      description
set-value:x:@.entry/0/*/path
   strings.concat
      .:magic/modules/
      get-value:x:@.arguments/*/moduleName
      .:/
      get-value:x:@.arguments/*/endpointName
set-value:x:@.entry/0/*/verb
   get-value:x:@.arguments/*/verb
set-value:x:@.entry/0/*/description
   get-value:x:@.endpoint/0
if
   and
      not-null:x:@.arguments/*/authorization
      neq:x:@.arguments/*/authorization
         .:
   .lambda
      add:x:@.entry/0
         .
            auth
      set-value:x:@.entry/0/*/auth
         get-value:x:@.arguments/*/authorization

/*
 * Loading the code-behind as a lambda object, and putting its entries back apart from any
 * earlier one for this very endpoint, so saving it again replaces it, followed by the new
 * entry. The entries are kept and re-added rather than removed one by one, since a list
 * cannot be changed while it is being iterated.
 */
io.file.load:/etc/www/.well-known/hyperlambda-agent.hl
.wellknown
add:x:@.wellknown
   hyper2lambda:x:@io.file.load
      comments:bool:true
.kept
for-each:x:@.wellknown/*/.metadata/*/.result/*/endpoints/*
   if
      not
         and
            eq:x:@.dp/#/*/path
               get-value:x:@.entry/0/*/path
            eq:x:@.dp/#/*/verb
               get-value:x:@.entry/0/*/verb
      .lambda
         add:x:@.kept
            get-nodes:x:@.dp/#
remove-nodes:x:@.wellknown/*/.metadata/*/.result/*/endpoints/*
add:x:@.wellknown/*/.metadata/*/.result/*/endpoints
   get-nodes:x:@.kept/*
add:x:@.wellknown/*/.metadata/*/.result/*/endpoints
   get-nodes:x:@.entry/*
.wellknown-hl
set-value:x:@.wellknown-hl
   lambda2hyper:x:@.wellknown/*
      comments:bool:true
io.file.save:/etc/www/.well-known/hyperlambda-agent.hl
   get-value:x:@.wellknown-hl

// Returning the generated endpoint to the caller, for preview.
unwrap:x:+/*
return
   result:success
   file:x:@.filename
   hyperlambda:x:@lambda2hyper
