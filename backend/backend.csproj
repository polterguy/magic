<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
    <AssemblyName>backend</AssemblyName>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- files/ is runtime content, read from this folder when running locally, so builds never scan it. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);files\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- A published build, such as the Docker image, runs from its output folder, so only publishing copies files/. -->
  <ItemGroup Condition="'$(_IsPublishing)' == 'true'">
    <None Include="files\**">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\plugins\magic.lambda.python\magic.lambda.python\magic.lambda.python.csproj" />
    <ProjectReference Include="..\plugins\magic.lambda.system\magic.lambda.system\magic.lambda.system.csproj" />
    <ProjectReference Include="..\plugins\magic.library\magic.library\magic.library.csproj" />
  </ItemGroup>

</Project>
