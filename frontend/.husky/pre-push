# Runs the frontend checks when the pushed commits touch frontend/, and skips them otherwise.
# git passes one line per pushed ref on stdin: <local ref> <local sha> <remote ref> <remote sha>
zero=0000000000000000000000000000000000000000
changed=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # deleting a remote branch
  if [ "$remote_sha" = "$zero" ]; then
    # New remote branch: compare against where it forked from master.
    base=$(git merge-base "$local_sha" origin/master 2>/dev/null || true)
    if [ -z "$base" ]; then
      changed=1 # no common history to compare against, so check everything
      continue
    fi
    range=$base..$local_sha
  else
    range=$remote_sha..$local_sha
  fi
  if git diff --name-only "$range" -- frontend | grep -q .; then
    changed=1
  fi
done

if [ "$changed" = 1 ]; then
  echo "pre-push: frontend changed, running format check, lint, typecheck and tests"
  cd frontend && npm run format:check && npm run lint && npm run typecheck && npm run test
fi
