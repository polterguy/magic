# =========================
# Runtime-only frontend image
# The dashboard is built in GitHub Actions before Docker runs
# =========================
FROM nginx:alpine

# MCP Registry ownership verification (matches name in server.json)
LABEL io.modelcontextprotocol.server.name="io.github.polterguy/magic"

# Remove default nginx config (optional but clean)
RUN rm /etc/nginx/conf.d/default.conf

# Copy the built dashboard
COPY frontend/dist /usr/share/nginx/html

# Copy custom nginx config
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
